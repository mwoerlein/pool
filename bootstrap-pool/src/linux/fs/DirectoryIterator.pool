/*[meta]
mimetype = text/x-pool
author = Marc Woerlein <marc.woerlein@gmx.de>
version = 0.1.0
*/
namespace linux::fs;

use linux::SysCall;
use linux::fs::File;
use linux::fs::FileElement;

use sys::core::String;
use sys::core::anycollection::AnyIterator;
use sys::core::utils::PropertiesMarshaller;
use sys::memory::Address;
use sys::memory::MemoryIOStream;

class DirectoryIterator extends AnyIterator {

    int fd;
    MemoryIOStream buffer;
    int read;
    int pos;
    int recursive;
    DirectoryIterator inner;
    String basePath;
    PropertiesMarshaller pm;
    
    [] __init() {
        this.basePath = this.createOwn(String:CLASSNAME);
        this.pm = this.createOwn(PropertiesMarshaller:CLASSNAME);
        this.buffer = this.createOwn(MemoryIOStream:CLASSNAME);
        this.buffer._init(1024);
        this.fd = -1;
        this.read = 0;
        this.pos = 0;
        this.recursive = false;
        this.inner = null;
    }
    
    [] __destroy() {
        this._closeFd();
    }

    [DirectoryIterator] _init(cstring dirname, int recursive) {
        fd = SysCall:open(dirname, File:MODE_DIR);
        basePath.assignCString(dirname);
        if (fd < 0) {
            this.rt().err().printCString("failed to open dir: ").printCString(dirname).printNewline();
            return null;
        }
        this.recursive = recursive;
        this._advance(false);
        return this;
    }
    
    [int] hasNext() {
        return pos < read;
    }
    
    [__all__] next() {
        if (inner) {
            __all__ n := inner.next();
            this._advance(false);
            return n;
        }
        if (pos >= read) { return null; }
        
        int buf := buffer.startAddr();
        cstring basename := Address:string(null, buf+pos+10);
        String filename := this._createAbsoluteName(basename);
        FileElement fe := this.rt().createInstance(FileElement:CLASSNAME);
        fe.init(filename, pm);
        fe.setCStringProperty("linux.filename", filename.toCString());
        fe.setCStringProperty("linux.basename", basename);
        
        this._advance(true); 
        
        return Address:convert(fe.storageElement());
    }
    
    [] _advance(int skipCurrent) {
        if (fd < 0) { return; }
        int buf := buffer.startAddr();
        int len := buffer.length();
        if (skipCurrent) {
            pos += Address:loadWord(buf+pos+8); 
        }
        do {
            if (inner) {
                if (inner.hasNext()) { return; }
                inner.destroy();
                inner = null;
                pos += Address:loadWord(buf+pos+8); 
            }
            while (pos < read) {
//                int inode := Address:loadDWord(buf+pos);
//                int offset := Address:loadDWord(buf+pos+4);
                int reclen := Address:loadWord(buf+pos+8);
                int type := Address:loadChar(buf+pos+reclen-1);
                if (type == SysCall:DT_REG) { return; }
                if (type == SysCall:DT_DIR && recursive) {
                    int c10 := Address:loadChar(buf+pos+10);
                    int c11 := Address:loadChar(buf+pos+11);
                    int c12 := Address:loadChar(buf+pos+12);
                    if (c10 == '.' && c11 == 0) {
                        // "."
                    } else if (c10 == '.' && c11 == '.' && c12 == 0) {
                        // ".."
                    } else {
                        String dirname := this._createAbsoluteName(Address:string(null, buf+pos+10));
                        inner = this.rt().createInstance(DirectoryIterator:CLASSNAME);
                        inner._init(dirname.toCString(), recursive);
                        inner.own(dirname);
                        if (inner.hasNext()) { return; }
                        inner.destroy();
                        inner = null;
                    }
                }
                pos += reclen; 
            }
            read = SysCall:getdents(fd, buf, len);
            pos = 0;
        } while (read > 0);
        this._closeFd();
    }
    
    [] _closeFd() {
        if (inner) { inner.destroy(); }
        if (fd >= 0) { SysCall:close(fd); fd = -1; pos = 0; read = 0; }
    }
    
    [String] _createAbsoluteName(cstring name) {
        String abs := this.rt().createInstance(String:CLASSNAME);
        abs.print(basePath).printChar('/').printCString(name);
        return abs;
    }
}
