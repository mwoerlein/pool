/*[meta]
mimetype = text/x-pool
author = Marc Woerlein <marc.woerlein@gmx.de>
version = 0.1.0
*/
namespace llm::token;

use sys::core::anycollection::AnyIterator;
use sys::core::anycollection::AnyList;
use sys::core::Integer;
use sys::stream::OStream;

class TokenList extends AnyList {

    int NOT_A_TOKEN := -1;

    [TokenList] appendToken(int tokenId) {
        Integer val = this.createOwn(Integer:CLASSNAME);
        val.assignInt(tokenId);
        this.add(val);
        return this;
    }

    [int] getTokenIdAt(int idx) {
        return TokenList:_extractToken(this.at(idx));
    }

    [int] hash() { return this._hashTokenList(); }
    [int] equals(__any__ obj) {
        TokenList c = this.rt().cast(TokenList:CLASSNAME, obj);
        return c && this._equalsTokenList(c);
    }
    
    [int] _hashTokenList() {
        int h = 0;
        AnyIterator it = this.iterator();
        while (it.hasNext()) {
            h = h * 31 + TokenList:_extractToken(it.next());
        }
        it.destroy();
        return h;
    }
    
    [int] _equalsTokenList(TokenList c) {
        if (this.size() != c.size()) { return false; }
        AnyIterator it1 = this.iterator();
        AnyIterator it2 = c.iterator();
        int eq = true;
        while (eq && it1.hasNext() && it2.hasNext()) {
            if (TokenList:_extractToken(it1.next()) != TokenList:_extractToken(it2.next())) {
                eq = false;
            }
        }
        it1.destroy();
        it2.destroy();
        return eq;
    }

    [OStream] printToStream(OStream stream) {
        stream.printChar('[');
        {
            AnyIterator it = this.iterator();
            if (it.hasNext()) { stream.print(it.next()); }
            while (it.hasNext()) { stream.printChar(',').printChar(' ').print(it.next()); }
            it.destroy();
        }
        return stream.printChar(']');
    }
    
    // TODO: remove with implicit cast
    [TokenList] tokenList() { return this; }

    global [int] _extractToken(Integer val) {
        if (!val) { return TokenList:NOT_A_TOKEN; }
        return val.getInt();
    }
}
