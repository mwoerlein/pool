namespace llm::io;

use sys::core::String;
use sys::core::math::FltMatrix;
use sys::core::math::FltVector;

class WeightLoader extends sys::core::Object {

    abstract [FltMatrix] loadMatrix(String id);
    abstract [FltMatrix] loadTMatrix(String id);
    abstract [FltVector] loadVector(String id);
    
    // TODO: remove with implicit cast
    [WeightLoader] weightLoader() { return this; }

}
