/*[meta]
mimetype = text/x-pool
author = Marc Woerlein <marc.woerlein@gmx.de>
version = 0.1.0
*/
namespace llm;

use llm::layer::LayerNormLayer;
use llm::layer::LinearLayer;
use llm::layer::MultiHeadAttention;
use llm::layer::ReLUFeedForwardLayer;
use llm::layer::RMSNormLayer;
use llm::layer::SelfAttention;
use llm::layer::SoftmaxLayer;
use llm::layer::SwiGLUFeedForwardLayer;

use sys::core::Flt;
use sys::core::math::FltMatrix;
use sys::core::math::FltVector;

class MatrixLayer extends sys::core::Object {

    int dModel;
    
    abstract [FltMatrix] forwardMatrix(FltMatrix x);
    
    // TODO: remove with implicit cast
    [MatrixLayer] matrixLayer() { return this; }
    
    // computation helper
    global [int] alpha(int dmFlt, int posFlt, int index) {
        return Flt:div(
                   posFlt,
                   Flt:pow(
                       Flt:TEN_THOUSAND_POS,
                       Flt:div(Flt:fromInt(index), dmFlt)
                   )
               );
    }

    
    // factory helper
    
    [FltMatrix] _emptyMatrix(int rows, int cols) {
        FltMatrix ret = this.rt().createInstance(FltMatrix:CLASSNAME);
        ret.init(rows, cols);
        return ret;
    }
    
    [FltVector] _emptyVector(int len) {
        FltVector ret = this.rt().createInstance(FltVector:CLASSNAME);
        ret.init(len);
        return ret;
    }
    
    [FltVector] _ensureVector(FltVector v, int len) {
        if (!v) { return this._emptyVector(len); }
        return v;
    }
    
    [LayerNormLayer] _ownLayerNormLayer(FltVector gamma, FltVector beta) {
        if (!gamma) { return null; }
        LayerNormLayer l = this.createOwn(LayerNormLayer:CLASSNAME);
        return l._init(gamma, this._ensureVector(beta, gamma.length()), Flt:ONE_TEN_THOUSANDTH_POS);
    }
    
    [LinearLayer] _ownLinearLayer(FltMatrix w, FltVector b) {
        if (!w) { return null; }
        LinearLayer l = this.createOwn(LinearLayer:CLASSNAME);
        return l._init(w, this._ensureVector(b, w.cols()));
    }
    
    [MultiHeadAttention] _ownMultiHeadAttention(int heads,
        FltMatrix wq, FltVector bq, FltMatrix wk, FltVector bk,
        FltMatrix wv, FltVector bv, FltMatrix wo, FltVector bo
    ) {
        if (!wq || !wk || !wv || !wo) { return null; }
        MultiHeadAttention a = this.createOwn(MultiHeadAttention:CLASSNAME);
        return a._init(heads,
            wq, this._ensureVector(bq, wq.cols()),
            wk, this._ensureVector(bk, wk.cols()),
            wv, this._ensureVector(bv, wv.cols()),
            wo, this._ensureVector(bo, wo.cols())
        );
    }
    
    [ReLUFeedForwardLayer] _ownReLUFeedForwardLayer(FltMatrix w1, FltVector b1, FltMatrix w2, FltVector b2) {
        if (!w1 || !w2) { return null; }
        ReLUFeedForwardLayer l = this.createOwn(ReLUFeedForwardLayer:CLASSNAME);
        return l._init(
            w1, this._ensureVector(b1, w1.cols()),
            w2, this._ensureVector(b2, w2.cols())
        );
    }
    
    [RMSNormLayer] _ownRMSNormLayer(FltVector gamma) {
        RMSNormLayer l = this.createOwn(RMSNormLayer:CLASSNAME);
        return l._init(gamma, Flt:ONE_HUNDRED_THOUSANDTH_POS);
    }
    
    [SelfAttention] _ownSelfAttention(FltMatrix wq, FltVector bq, FltMatrix wk, FltVector bk, FltMatrix wv, FltVector bv) {
        if (!wq || !wk || !wv) { return null; }
        SelfAttention a = this.createOwn(SelfAttention:CLASSNAME);
        return a._init(
            wq, this._ensureVector(bq, wq.cols()),
            wk, this._ensureVector(bk, wk.cols()),
            wv, this._ensureVector(bv, wv.cols())
        );
    }
    
    [SoftmaxLayer] _ownSoftmaxLayer() {
        SoftmaxLayer l = this.createOwn(SoftmaxLayer:CLASSNAME);
        return l;
    }

    [SwiGLUFeedForwardLayer] _ownSwiGLUFeedForwardLayer(FltMatrix wg, FltVector bg, FltMatrix wu, FltVector bu, FltMatrix wd, FltVector bd) {
        if (!wg || !wu || !wd) { return null; }
        SwiGLUFeedForwardLayer l = this.createOwn(SwiGLUFeedForwardLayer:CLASSNAME);
        return l._init(
            wg, this._ensureVector(bg, wg.cols()),
            wu, this._ensureVector(bu, wu.cols()),
            wd, this._ensureVector(bd, wd.cols())
        );
    }
    
    [Embedding] _ownEmbedding(FltMatrix weights) {
        Embedding e = this.createOwn(Embedding:CLASSNAME);
        return e._init(weights);
    }

}
