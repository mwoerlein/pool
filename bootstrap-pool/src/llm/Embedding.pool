/*[meta]
mimetype = text/x-pool
author = Marc Woerlein <marc.woerlein@gmx.de>
version = 0.1.0
*/
namespace llm;

use sys::core::Flt;
use sys::core::Integer;
use sys::core::anycollection::AnyList;
use sys::core::anycollection::AnyIterator;
use sys::core::math::FltMatrix;
use sys::core::math::FltVector;

class Embedding extends sys::core::Object {

    FltMatrix weights; // vocab_size x d_model
    int usePE;
    
    int dModel;
    
    [Embedding] _init(FltMatrix weights) {
        if (!weights) { return null; }
        this.weights = this.own(weights);
        this.dModel = weights.cols();
        return this;
    }
    [Embedding] usePE(int b) {
        this.usePE = b;
        return this;
    }
    [int] getDModel() { return dModel; }
   
    [FltMatrix] forwardTokens(AnyList tokenIds) {
        if (!tokenIds) { return null; }
        int dm := this.dModel;
        FltMatrix ret = this.rt().createInstance(FltMatrix:CLASSNAME);
        ret.init(tokenIds.size(), dm);
        
        AnyIterator it = tokenIds.iterator();
        int pos = 0;
        if (usePE) {
            int dmFlt := Flt:fromInt(dm);
            while (it.hasNext()) {
                Integer tokenObj := it.next();
                int token = tokenObj.getInt();
                int posFlt := Flt:fromInt(pos);
                int i = dm;
                while (i--) {
                    if (i % 2) {
                        ret.set(pos++, i, Flt:add(
                            this.weights.get(token, i),
                            Flt:cos(MatrixLayer:alpha(dmFlt, posFlt, i - 1))
                        ));
                    } else {
                        ret.set(pos++, i, Flt:add(
                            this.weights.get(token, i),
                            Flt:sin(MatrixLayer:alpha(dmFlt, posFlt, i))
                        ));
                    }
                }
            }
        } else {
            while (it.hasNext()) {
                Integer tokenObj := it.next();
                int token = tokenObj.getInt();
                int i = dm;
                while (i--) {
                    ret.set(pos++, i, this.weights.get(token, i));
                }
            }
        }
        it.destroy();
        
        return ret;
    }
    
}
