/*[meta]
mimetype = text/x-pool
author = Marc Woerlein <marc.woerlein@gmx.de>
version = 0.1.0
*/
namespace llm;

use sys::core::Flt;
use sys::core::Integer;
use sys::core::math::FltMatrix;
use llm::Model;
use llm::model::TokenList;
use llm::token::TokenSampler;

class GenerationLoop extends sys::core::Object {

    Model model;
    TokenSampler sampler;
    int eosTokenId;

    [GenerationLoop] _init(Model model, int temperature, int topK, int eosTokenId) {
        if (!model) { return null; }
        this.model = model;
        this.eosTokenId = eosTokenId;
        this.sampler = this.createOwn(TokenSampler:CLASSNAME);
        this.sampler._init(temperature, topK);
        return this;
    }

    [int] generateInto(TokenList tokenIds, int maxNewTokens) {
        if (!tokenIds) { return 0; }

        int step = 0;
        int running = 1;
        while (step < maxNewTokens && running) {
            this.rt().out().printChar('.');

            FltMatrix logits = this.model.forwardTokens(tokenIds);
            
            if (!logits) {
                running = 0;
            } else {
                int nextToken = this.sampler.sampleToken(logits);
                
                logits.destroy();

                if (nextToken == -1 || nextToken == eosTokenId) {
                    running = 0;
                } else {
                    tokenIds.appendToken(nextToken);
                    step++;
                }
            }
        }

        return step;
    }
    
}
