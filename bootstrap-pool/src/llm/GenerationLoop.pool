/*[meta]
mimetype = text/x-pool
author = Marc Woerlein <marc.woerlein@gmx.de>
version = 0.1.0
*/
namespace llm;

use sys::core::Flt;
use sys::core::Integer;
use sys::core::anycollection::AnyList;
use sys::core::math::FltMatrix;
use llm::model::LlamaModel;

class GenerationLoop extends sys::core::Object {

    LlamaModel model;
    int temperature; // Stored as Flt representation
    int topK;
    int eosTokenId;

    [GenerationLoop] _init(LlamaModel model, int temperature, int topK, int eosTokenId) {
        if (!model) { return null; }
        this.model = model;
        this.temperature = temperature;
        this.topK = topK;
        this.eosTokenId = eosTokenId;
        return this;
    }

    [int] generateInto(AnyList tokenIds, int maxNewTokens) {
        if (!tokenIds) { return 0; }

        int step = 0;
        int running = 1;
        while (step < maxNewTokens && running) {
            this.rt().out().printChar('.');

            FltMatrix logits = this.model.forwardTokens(tokenIds);
            
            if (!logits) {
                running = 0;
            } else {
                int nextToken = this.sampleToken(logits);
                logits.destroy();

                if (nextToken == eosTokenId) {
                    running = 0;
                } else {
                    Integer newInt = this.rt().createInstance(Integer:CLASSNAME);
                    newInt.assignInt(nextToken);
                    tokenIds.add(newInt);
                    step++;
                }
            }
        }

        return step;
    }

    [int] sampleToken(FltMatrix logits) {
        int lastRow = logits.rows() - 1;

        // Greedy search if temperature <= 0.0 (compare <= 0 returns <= 0)
        if (Flt:compare(this.temperature, Flt:ZERO_POS) <= 0) {
            return logits.rowMaxCol(lastRow);
        }

        // Temperature scaling, softmax, top-k, and multinomial sampling can be added here
        // Fallback to greedy if temperature > 0 but advanced sampling not fully wired yet
        return logits.rowMaxCol(lastRow);
    }
}
