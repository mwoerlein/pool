/*[meta]
mimetype = text/x-pool
author = Marc Woerlein <marc.woerlein@gmx.de>
version = 0.1.0
*/
namespace llm;

use sys::core::Flt;
use sys::core::math::FltMatrix;
use sys::core::math::FltVector;

class EmbeddingWithPositionalEncoding extends sys::core::Object {

    FltMatrix weights; // vocab_size x d_model
    
    [EmbeddingWithPositionalEncoding] _init(FltMatrix weights) {
        if (!weights) { return null; }
        this.weights = this.own(weights);
        return this;
    }
   
    [FltMatrix] forwardTokens(FltVector tokenIds) {
        if (!tokenIds) { return null; }
        int dm := this.weights.cols();
        int dmFlt := Flt:fromInt(dm);
        int pos = tokenIds.length();
        FltMatrix ret = this.rt().createInstance(FltMatrix:CLASSNAME);
        ret.init(pos, dm);
        
        while (pos--) {
            int posFlt := Flt:fromInt(pos);
            int token := Flt:floor(tokenIds.get(pos)); // create and use IntArray for token IDs?
            int i = dm;
            while (i--) {
                ret.set(pos, i, Flt:add(
                    this.weights.get(token, i),
                    this._positionalEncoding(dmFlt, posFlt, i)
                ));
            }
        }
        
        return ret;
    }
    
    [int] _positionalEncoding(int dmFlt, int posFlt, int index) {
        if (index % 2) {
            return Flt:cos(Flt:div(
                posFlt,
                Flt:pow(
                    Flt:TEN_THOUSAND_POS,
                    Flt:div(Flt:fromInt(index-1), dmFlt)
                )
            ));
        } else {
            return Flt:sin(Flt:div(
                posFlt,
                Flt:pow(
                    Flt:TEN_THOUSAND_POS,
                    Flt:div(Flt:fromInt(index), dmFlt)
                )
            ));
        }
    }
}
