/*[meta]
mimetype = text/x-pool
author = Marc Woerlein <marc.woerlein@gmx.de>
version = 0.1.0
*/
namespace llm::layer;

use sys::core::Flt;
use sys::core::math::FltVector;
use sys::core::math::FltMatrix;

class FeedForwardLayer extends llm::VectorLayer {

    LinearLayer layer1;
    LinearLayer layer2;
    
    [FeedForwardLayer] _init(FltMatrix w1, FltVector b1, FltMatrix w2, FltVector b2) {
        this.layer1 = this._ownLinearLayer(w1, b1);
        this.layer2 = this._ownLinearLayer(w2, b2);
        if (!layer1 || !layer2 || layer1.getDOut() != layer2.getDIn()) {
            return null;
        }
        this.dModel = layer1.dModel;
        
        return this;
    }
    
    [int] getDIn() { return layer1.getDIn(); }     
    [int] getDOut() { return layer2.getDOut(); }     
    
    [FltVector] forwardVector(FltVector x) {
        FltVector tmp = layer1.forwardVector(x);
        if (!tmp) { return null; }
        // ReLU
        int i = tmp.length();
        while (i--) {
            if (Flt:compare(tmp.get(i), Flt:ZERO_POS) < 0) {
                tmp.set(i, Flt:ZERO_POS);
            }
        }
        FltVector y = layer2.forwardVector(tmp);
        tmp.destroy();
        return y;
    }
    
}
