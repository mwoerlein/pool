/*[meta]
mimetype = text/x-pool
author = Marc Woerlein <marc.woerlein@gmx.de>
version = 0.1.0
*/
namespace llm::layer;

use sys::core::Flt;
use sys::core::math::FltVector;
use sys::core::math::FltMatrix;

class RMSNormLayer extends llm::VectorLayer {

    FltVector gamma;
    int epsilon;
    
    [RMSNormLayer] _init(FltVector gamma, int epsilon) {
        if (!gamma) {
            return null;
        }
        this.dModel = gamma.length();
        this.gamma = this.own(gamma);
        this.epsilon = epsilon;
        return this;
    }

    [FltVector] forwardVector(FltVector x) {
        if (!x || !gamma || x.length() != dModel) {
            return null;
        }
        int dm := this.dModel;
        int lenF := Flt:fromInt(dm);
        int mean := Flt:div(x.sum(), lenF);
        int sqrsum = Flt:ZERO_POS;
        {
            int i = dm;
            while (i--) {
                sqrsum = Flt:add(sqrsum, Flt:sqr(x.get(i)));
            }
        }
        
        FltVector y := this._emptyVector(dm);
        int rms := Flt:sqrt(Flt:add(Flt:div(sqrsum, lenF), epsilon));
        {
            int i = dm;
            while (i--) {
                y.set(i, Flt:mul(
                    Flt:div(x.get(i), rms),
                    gamma.get(i)
                ));
            }
        }
        return y;
    }
}
