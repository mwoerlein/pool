/*[meta]
mimetype = text/x-pool
author = Marc Woerlein <marc.woerlein@gmx.de>
version = 0.1.0
*/
namespace llm::layer;

use llm::MatrixLayer;
use llm::layer::LinearLayer;
use llm::layer::SoftmaxLayer;

use sys::core::Flt;
use sys::core::math::FltVector;
use sys::core::math::FltMatrix;

class MultiHeadAttention extends llm::MatrixLayer {

    LinearLayer linearQ;
    LinearLayer linearK;
    LinearLayer linearV;
    LinearLayer linearO;
    SoftmaxLayer softmax;
    int heads;
    int dHead;
    int scale;
    int useRoPE;
    int useCM;
    
    [MultiHeadAttention] _init(int heads, FltMatrix wq, FltVector bq, FltMatrix wk, FltVector bk, FltMatrix wv, FltVector bv, FltMatrix wo, FltVector bo) {
        linearQ = this._ownLinearLayer(wq, bq);
        linearK = this._ownLinearLayer(wk, bk);
        linearV = this._ownLinearLayer(wv, bv);
        linearO = this._ownLinearLayer(wo, bo);
        if (!linearQ || !linearK || !linearV || !linearO) {
            return null;
        }
        int dm = linearQ.getDIn();
        if (dm % heads) { return null; } 
        this.heads = heads;
        this.dModel = dm;
        this.dHead = dm/heads;
        if ( linearQ.getDIn() != dm || linearQ.getDOut() != dm
            || linearK.getDIn() != dm || linearK.getDOut() != dm
            || linearV.getDIn() != dm || linearV.getDOut() != dm
            || linearO.getDIn() != dm || linearO.getDOut() != dm
        ) {
            return null;
        }
        this.softmax = this._ownSoftmaxLayer();
        this.scale = Flt:sqrt(Flt:fromInt(this.dHead));
        return this;
    }
    [MultiHeadAttention] useRoPE(int b) {
        this.useRoPE = b;
        return this;
    }
    [MultiHeadAttention] useCM(int b) {
        this.useCM = b;
        return this;
    }
    
    [FltMatrix] forwardMatrix(FltMatrix x) {
        FltMatrix q := linearQ.forwardMatrix(x);
        FltMatrix k := linearK.forwardMatrix(x);
        FltMatrix v := linearV.forwardMatrix(x);
        if (!q || !k || !v) { return null; }
        if (useRoPE) { this.applyRoPE(q, k); }
/*        
        this.rt().err().printNewline()
            .printCString("Q: ").print(q).printNewline()
            .printCString("K: ").print(k).printNewline()
            .printCString("V: ").print(v).printNewline()
        ;
*/        
        int dm := this.dModel;
        int dh := this.dHead;
        int dt := x.rows();
        int sh := this.scale;
        FltMatrix tmp := this._emptyMatrix(dt, dm);
        
        if (dt) {
            FltMatrix scores := this._emptyMatrix(dt, dt);
            int i = this.heads;
            while (i--) {
                int start := i*dh;
                if (!FltMatrix:mtMulInto(q, 0, start, k, 0, start, scores, 0, 0, dt, dt, dh)) {
                    this.rt().err().printCString("aaaahhhh1").printNewline();
                }
/*
                this.rt().err()
                    .printInt(i).printCString("-scores: ").print(scores).printNewline()
                ;
*/
                scores.divFlt(sh);
                if (useCM) { SelfAttention:applyCausalMask(scores); }
                FltMatrix weights := softmax.forwardMatrix(scores);
                if (!FltMatrix:mmMulInto(weights, 0, 0, v, 0, start, tmp, 0, start, dt, dh, dt)) {
                    this.rt().err().printCString("aaaahhhh2").printNewline();
                }
/*
                this.rt().err()
                    .printInt(i).printCString("-scaled: ").print(scores).printNewline()
                    .printInt(i).printCString("-weights: ").print(weights).printNewline()
                    .printInt(i).printCString("-tmp: ").print(tmp).printNewline()
                ;
*/
                weights.destroy();
            }
            scores.destroy();
        }
        
        FltMatrix y := linearO.forwardMatrix(tmp);
/*
        this.rt().err()
            .printCString("tmp: ").print(tmp).printNewline()
            .printCString("Y: ").print(y).printNewline()
        ;
*/        
        tmp.destroy();
        v.destroy();
        k.destroy();
        q.destroy();
        return y;
    }
    
    [] applyRoPE(FltMatrix q, FltMatrix k) {
        int dmFlt := Flt:fromInt(dModel);
        int dh := this.dHead;
        int pos = q.rows();
        while (pos--) {
            int posFlt := Flt:fromInt(pos);
            int i = this.heads;
            while (i--) {
                int start := i*dh;
                int j := start + dh;
                while (j > start) {
                    int idx2 := --j;
                    int idx1 := --j;
                    int alpha := MatrixLayer:alpha(dmFlt, posFlt, idx1 - start);
                    int cosA := Flt:cos(alpha);
                    int sinA := Flt:sin(alpha);
                    
                    // In-place rotation for matrix Q
                    int q1 := q.get(pos, idx1);
                    int q2 := q.get(pos, idx2);
                    q.set(pos, idx1, Flt:sub(Flt:mul(q1, cosA), Flt:mul(q2, sinA)));
                    q.set(pos, idx2, Flt:add(Flt:mul(q2, cosA), Flt:mul(q1, sinA)));
                    
                    // In-place rotation for matrix K
                    int k1 := k.get(pos, idx1);
                    int k2 := k.get(pos, idx2);
                    k.set(pos, idx1, Flt:sub(Flt:mul(k1, cosA), Flt:mul(k2, sinA)));
                    k.set(pos, idx2, Flt:add(Flt:mul(k2, cosA), Flt:mul(k1, sinA)));
                }
            }
        }
    }

}
