namespace pool::storage;

use sys::storage::IOStreamStorage;

class Store extends ClassLoadingStorage, IOStreamStorage {
    
    [] __init() {
        this._initClassDescriptorLoader();
        this._initIOStreamStorage();
    }
    [] __destruct() {
        this._destructIOStreamStorage();
    }
    
}
