/*[meta]
mimetype = text/x-pool
author = Marc Woerlein <marc.woerlein@gmx.de>
version = 0.1.0
*/
namespace sys::core::math;

use sys::core::Flt;
use sys::stream::OStream;

class FltMatrix extends sys::core::utils::DWordArray {
    
    int _rows;
    int _cols;
    
    [] init(int rows, int cols) {
        this._rows = rows;
        this._cols = cols;
        this._initDWordArray(rows * cols);
        this._setAllDWord(Flt:ZERO_POS);
    }
    
    [] initWith(int rows, int cols, int value) {
        this._rows = rows;
        this._cols = cols;
        this._initDWordArray(rows * cols);
        this._setAllDWord(value);
    }
    
    [] clear() {
        this._setAllDWord(Flt:ZERO_POS);
    }
    
    [int] rows() { return _rows; }
    [int] cols() { return _cols; }
    
    [int] set(int row, int col, int value) {
        if (row < 0 || row >= _rows || col < 0 || col >= _cols) {
            return Flt:NAN;
        }
        return this._saveSetDWord(row * _cols + col, value);
    }
    
    [int] get(int row, int col) {
        if (row < 0 || row >= _rows || col < 0 || col >= _cols) {
            return Flt:NAN;
        }
        return this._saveGetDWord(row * _cols + col);
    }
    
    [FltMatrix] setRowFromVector(int row, FltVector v) {
        if (row < 0 || row >= _rows || v.length() != _cols) {
            return null;
        }
        this._saveSetDWordArray(row * _cols, v.dwordArray());
        return this;
    }
    
    [FltVector] getRowAsVector(int row) {
        if (row < 0 || row >= _rows) {
            return null;
        }
        FltVector v = this.rt().createInstance(FltVector:CLASSNAME);
        v.init(_cols);
        this._saveGetDWordArray(row * _cols, v.dwordArray());
        return v;
    }
    
    [FltMatrix] mulFlt(int f) {
        int i = this._size;
        while (i--) {
            this._saveSetDWord(i, Flt:mul(this._saveGetDWord(i), f));
        }
        return this;
    }
    
    [FltMatrix] divFlt(int f) {
        int i = this._size;
        while (i--) {
            this._saveSetDWord(i, Flt:div(this._saveGetDWord(i), f));
        }
        return this;
    }
    
    [int] rowMax(int row) {
        int i = this._cols - 1;
        int pos = row * this._cols;
        int ret = this._saveGetDWord(pos++);
        while (i--) {
            ret = Flt:max(ret, this._saveGetDWord(pos++));
        }
        return ret;
    }
    
    [FltMatrix] rowMulFlt(int row, int f) {
        int i = this._cols;
        int pos = row * this._cols;
        while (i--) {
            this._saveSetDWord(pos, Flt:mul(this._saveGetDWord(pos), f));
            pos++;
        }
        return this;
    }
    
    [FltMatrix] rowDivFlt(int row, int f) {
        int i = this._cols;
        int pos = row * this._cols;
        while (i--) {
            this._saveSetDWord(pos, Flt:div(this._saveGetDWord(pos), f));
            pos++;
        }
        return this;
    }
    
    [FltMatrix] add(FltMatrix mat) {
        if (!mat || this._rows != mat._rows || this._cols != mat._cols) {
            return null;
        }
        int i = this._size;
        while (i--) {
            this._saveSetDWord(i, Flt:add(this._saveGetDWord(i), mat._saveGetDWord(i)));
        }
        return this;
    }
    
    [FltMatrix] sub(FltMatrix mat) {
        if (!mat || this._rows != mat._rows || this._cols != mat._cols) {
            return null;
        }
        int i = this._size;
        while (i--) {
            this._saveSetDWord(i, Flt:sub(this._saveGetDWord(i), mat._saveGetDWord(i)));
        }
        return this;
    }
    
    [int] compareFltMatrix(FltMatrix v) { 
        if (_rows != v.rows()) { return _rows - v.rows(); }
        if (_cols != v.cols()) { return _cols - v.cols(); }
        int i = 0;
        while (i < _size) {
            int c := Flt:compare(this._saveGetDWord(i), v._saveGetDWord(i));
            if (c) { return c; }
            i++;
        }
        return 0;
    }

    [OStream] printToStream(OStream stream) {
        stream.printChar('[');
        if (_rows > 0) {
            this._printRowFromPosToStream(stream, 0);
            int i = 1;
            while (i < _rows) {
                this._printRowFromPosToStream(stream.printChar(',').printChar(' '), i++);
            }
        }
        return stream.printChar(']');
    }
    [OStream] _printRowFromPosToStream(OStream stream, int row) {
        stream.printChar('[');
        if (_cols > 0) {
            int i = row * _cols;
            int end = i + _cols;
            stream.printFlt(this._saveGetDWord(i++));
            while (i < end) {
                stream.printChar(',').printChar(' ').printFlt(this._saveGetDWord(i++));
            }
        }
        return stream.printChar(']');
    }

    [OStream] debugToStream(OStream stream) {
        stream.printChar('[');
        if (_rows > 0) {
            this._debugRowFromPosToStream(stream, 0);
            int i = 1;
            while (i < _rows) {
                this._debugRowFromPosToStream(stream.printChar(',').printChar(' '), i++);
            }
        }
        return stream.printChar(']');
    }
    [OStream] _debugRowFromPosToStream(OStream stream, int row) {
        stream.printChar('[');
        if (_cols > 0) {
            int i = row * _cols;
            int end = i + _cols;
            stream.printPtr(this._saveGetDWord(i++));
            while (i < end) {
                stream.printChar(',').printChar(' ').printPtr(this._saveGetDWord(i++));
            }
        }
        return stream.printChar(']');
    }
    
    global [FltVector] mvMul(FltMatrix a, FltVector b) {
        if (!a || !b || a._cols != b.length()) {
            return null;
        }
        
        FltVector ret = a.rt().createInstance(FltVector:CLASSNAME);
        ret.init(a._rows);
        int i = a._rows;
        while (i--) {
            int sum = Flt:ZERO_POS;
            int k = a._cols;
            while (k--) {
                sum = Flt:add(sum, Flt:mul(a.get(i, k), b.get(k)));
            }
            ret.set(i, sum);
        }
        return ret;
    }
    
    global [FltVector] vmMul(FltVector a, FltMatrix b) {
        if (!a || !b || a.length() != b._rows) {
            return null;
        }
        
        FltVector ret = a.rt().createInstance(FltVector:CLASSNAME);
        ret.init(b._cols);
        int i = b._cols;
        while (i--) {
            int sum = Flt:ZERO_POS;
            int k = b._rows;
            while (k--) {
                sum = Flt:add(sum, Flt:mul(a.get(k), b.get(k, i)));
            }
            ret.set(i, sum);
        }
        return ret;
    }
    
    global [FltMatrix] mmMul(FltMatrix a, FltMatrix b) {
        if (!a || !b || a._cols != b._rows) {
            return null;
        }
        
        FltMatrix ret = a.rt().createInstance(FltMatrix:CLASSNAME);
        ret.init(a._rows, b._cols);
        int i = a._rows;
        while (i--) {
            int j = b._cols;
            while (j--) {
                int sum = Flt:ZERO_POS;
                int k = a._cols;
                while (k--) {
                    sum = Flt:add(sum, Flt:mul(a.get(i, k), b.get(k, j)));
                }
                ret.set(i, j, sum);
            }
        }
        return ret;
    }

    global [FltMatrix] mtMul(FltMatrix a, FltMatrix b_t) {
        if (!a || !b_t || a._cols != b_t._cols) {
            return null;
        }
        
        FltMatrix ret = a.rt().createInstance(FltMatrix:CLASSNAME);
        ret.init(a._rows, b_t._rows);
        int i = a._rows;
        while (i--) {
            int j = b_t._rows;
            while (j--) {
                int sum = Flt:ZERO_POS;
                int k = a._cols;
                while (k--) {
                    sum = Flt:add(sum, Flt:mul(a.get(i, k), b_t.get(j, k)));
                }
                ret.set(i, j, sum);
            }
        }
        return ret;
    }

    global [FltMatrix] transpose(FltMatrix a) {
        if (!a) {
            return null;
        }
        
        FltMatrix ret = a.rt().createInstance(FltMatrix:CLASSNAME);
        ret.init(a._cols, a._rows);
        int i = a._rows;
        while (i--) {
            int j = a._cols;
            while (j--) {
                ret.set(j, i, a.get(i, j));
            }
        }
        return ret;
    }
    
    global [FltMatrix] mmMulInto(
        FltMatrix a, int startRowA, int startColA,
        FltMatrix b, int startRowB, int startColB, 
        FltMatrix r, int startRowR, int startColR,
        int rows, int cols, int commons 
    ) {
//*/
        if (!a || !b || !r || rows < 0 || cols < 0 || commons < 0
            || startRowA < 0 || startColA < 0 || startRowA + rows > a.rows() || startColA + commons > a.cols()
            || startRowB < 0 || startColB < 0 || startRowB + commons > b.rows() || startColB + cols > b.cols()
            || startRowR < 0 || startColR < 0 || startRowR + rows > r.rows() || startColR + cols > r.cols()
        ) { return null; }
/*/
        if (!a || !b || !r || rows < 0 || cols < 0 || commons < 0) { return null; }
        if (startRowA < 0 || startColA < 0 || startRowA + rows > a.rows() || startColA + commons > a.cols()) {
            a.rt().err().printCString("Problem A").printNewline()
                .printCString("startRow: ").printInt(startRowA).printNewline()
                .printCString("endRow  : ").printInt(startRowA+rows).printNewline()
                .printCString("rows    : ").printInt(a.rows()).printNewline()
                .printCString("startCol: ").printInt(startColA).printNewline()
                .printCString("endCol  : ").printInt(startColA+commons).printNewline()
                .printCString("cols    : ").printInt(a.cols()).printNewline()
            ;
            return null;
        }
        if (startRowB < 0 || startColB < 0 || startRowB + commons > b.rows() || startColB + cols > b.cols()) {
            b.rt().err().printCString("Problem B").printNewline()
                .printCString("startRow: ").printInt(startRowB).printNewline()
                .printCString("endRow  : ").printInt(startRowB+commons).printNewline()
                .printCString("rows    : ").printInt(b.rows()).printNewline()
                .printCString("startCol: ").printInt(startColB).printNewline()
                .printCString("endCol  : ").printInt(startColB+cols).printNewline()
                .printCString("cols    : ").printInt(b.cols()).printNewline()
            ;
            return null;
        }
        if (startRowR < 0 || startColR < 0 || startRowR + rows > r.rows() || startColR + cols > r.cols()) {
            r.rt().err().printCString("Problem R").printNewline();
            return null;
        }
//*/         
        
        int i = rows;
        while (i--) {
            int j = cols;
            while (j--) {
                int sum = Flt:ZERO_POS;
                int k = commons;
                while (k--) {
                    sum = Flt:add(sum, Flt:mul(
                        a.get(startRowA + i, startColA + k),
                        b.get(startRowB + k, startColB + j)
                    ));
                }
                r.set(startRowR + i, startColR + j, sum);
            }
        }
        return r;
    }
    
    global [FltMatrix] mtMulInto(
        FltMatrix a, int startRowA, int startColA,
        FltMatrix b, int startRowB, int startColB, 
        FltMatrix r, int startRowR, int startColR,
        int rows, int cols, int commons 
    ) {
//*/
        if (!a || !b || !r || rows < 0 || cols < 0 || commons < 0
            || startRowA < 0 || startColA < 0 || startRowA + rows > a.rows() || startColA + commons > a.cols()
            || startRowB < 0 || startColB < 0 || startRowB + cols > b.rows() || startColB + commons > b.cols()
            || startRowR < 0 || startColR < 0 || startRowR + rows > r.rows() || startColR + cols > r.cols()
        ) { return null; }
/*/
        if (!a || !b || !r || rows < 0 || cols < 0 || commons < 0) { return null; }
        if (startRowA < 0 || startColA < 0 || startRowA + rows > a.rows() || startColA + commons > a.cols()) {
            a.rt().err().printCString("Problem A").printNewline()
                .printCString("startRow: ").printInt(startRowA).printNewline()
                .printCString("endRow  : ").printInt(startRowA+rows).printNewline()
                .printCString("rows    : ").printInt(a.rows()).printNewline()
                .printCString("startCol: ").printInt(startColA).printNewline()
                .printCString("endCol  : ").printInt(startColA+commons).printNewline()
                .printCString("cols    : ").printInt(a.cols()).printNewline()
            ;
            return null;
        }
        if (startRowB < 0 || startColB < 0 || startRowB + cols > b.rows() || startColB + commons > b.cols()) {
            b.rt().err().printCString("Problem B").printNewline()
                .printCString("startRow: ").printInt(startRowB).printNewline()
                .printCString("endRow  : ").printInt(startRowB+cols).printNewline()
                .printCString("rows    : ").printInt(b.rows()).printNewline()
                .printCString("startCol: ").printInt(startColB).printNewline()
                .printCString("endCol  : ").printInt(startColB+commons).printNewline()
                .printCString("cols    : ").printInt(b.cols()).printNewline()
            ;
            return null;
        }
        if (startRowR < 0 || startColR < 0 || startRowR + rows > r.rows() || startColR + cols > r.cols()) {
            r.rt().err().printCString("Problem R").printNewline();
            return null;
        }
 //*/       
        int i = rows;
        while (i--) {
            int j = cols;
            while (j--) {
                int sum = Flt:ZERO_POS;
                int k = commons;
                while (k--) {
                    sum = Flt:add(sum, Flt:mul(
                        a.get(startRowA + i, startColA + k),
                        b.get(startRowB + j, startColB + k)
                    ));
                }
                r.set(startRowR + i, startColR + j, sum);
            }
        }
        return r;
    }
    
}
