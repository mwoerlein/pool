/*[meta]
mimetype = text/x-pool
author = Marc Woerlein <marc.woerlein@gmx.de>
version = 0.1.0
*/
namespace sys::storage;

use sys::core::String;
use sys::core::anycollection::AnyIterator;
use sys::core::utils::PropertiesMarshaller;
use sys::core::utils::PropertyContainer;
use sys::memory::Address;
use sys::memory::MemoryIOStream;
use sys::runtime::ClassDescriptor;
use sys::runtime::ClassDescriptorLoader;
use sys::storage::IOStreamElement;
use sys::storage::IOStreamStorageIterator;
use sys::storage::Mimetype;
use sys::storage::StorageElement;
use sys::storage::StorageElementDesc;
use sys::stream::SeekableIOStream;

class IOStreamStorage extends Storage, IOStreamElement {

    int elementCount;
    StorageElementDesc first;
    
    PropertiesMarshaller pm;
        
    [] __init() { this._initIOStreamStorage(); }
    [] _initIOStreamStorage() {
        this._initStorageElement();
        this.pm = this.createOwn(PropertiesMarshaller:CLASSNAME);
    }
    [] __destruct() { this._destructIOStreamStorage(); }
    [] _destructIOStreamStorage() {
        this._destructStorageElement();
    }
    
    [IOStreamStorage] _initFromStream(SeekableIOStream content) {
        content.seek(0);
        this.init(content, this.pm);

        String elements = this.getCStringProperty("store.elements");
        if (elements) {
            elementCount = elements.toInt();
//    this.rt().err().printCString("store.elements: ").printInt(elementCount).printNewline();
            
            // read element descriptors into memory
            int descLen = elementCount * StorageElementDesc:SIZEOF;
            MemoryIOStream desc = this.createOwn(MemoryIOStream:CLASSNAME);
            desc._init(descLen);
            content.printNToStream(descLen, desc.ostream());
            
            // build in-memory index
            StorageElementDesc cur = Address:cast(desc.startAddr());
            first = cur;
            int i = elementCount;
            while (--i > 0) {
                cur.next = Address:offset(cur, StorageElementDesc:SIZEOF);
                // TODO: use hashmaps for more efficient access?!?
                cur = cur.next;
            }
            cur.next = null;
        } else {
            // TODO: Bailout? Read old index? 
//    this.rt().err().printCString("store.elements not found!").printNewline();
        }
        return this;
    }
    
    [StorageElement] getElement(String name, int mimeType) {
//    this.rt().err().printCString("get element: ").print(name).printNewline();
        StorageElementDesc cur = first;
        while (cur) {
            if (this._descMatches(cur, name, mimeType)) {
                StorageElement e = this._getElementFromDesc(cur);
                if (this._elementMatches(e, name, mimeType)) {
//    this.rt().err().printCString("found element: ").print(name).printNewline();
                    return e;
                }
                e.destroy();
            }
            cur = cur.next;
        }
        return null;
    }
    
    [AnyIterator] elements() {
        IOStreamStorageIterator it = this.rt().createInstance(IOStreamStorageIterator:CLASSNAME);
        it.init(this, first);
        return it.iterator();
    }
    
    [StorageElement] _getElementFromDesc(StorageElementDesc desc) {
        IOStreamElement e = this.rt().createInstance(IOStreamElement:CLASSNAME);
        e.init(data.getView(desc.start, desc.size), pm);
        // TODO: update element descriptor with storage element information
        return e.storageElement();
    }
    
    [int] _descMatches(StorageElementDesc desc, String name, int mimeType) {
        if (desc.mimeType && (desc.mimeType != mimeType)) { return false; }
        if (desc.nameHash && (desc.nameHash != name.hash())) { return false; }
        return true;
    }
    
    [int] _elementMatches(StorageElement se, String name, int mimeType) {
        // TODO: implement mimeType specific checks
        return true;
    }
}
