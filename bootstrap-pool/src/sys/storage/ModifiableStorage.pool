namespace sys::storage;

use sys::core::String;
use sys::core::utils::PropertyContainer;
use sys::stream::OStream;

class ModifiableStorage extends Storage {
    
    abstract [OStream] createElement(String name, int mimeType, PropertyContainer properties);
    abstract [int] removeElement(String name, int mimeType);
    
    // TODO: remove with implicit cast
    [ModifiableStorage] modifiableStorage() { return this; }
   
}
