/*[meta]
mimetype = text/x-pool
author = Marc Woerlein <marc.woerlein@gmx.de>
version = 0.1.0
*/
namespace vector::graphics::builder;

use sys::core::Flt;
use sys::core::String;

use vector::graphics::Graphic;
use vector::graphics::path::Path;
use vector::graphics::shape::PathShape;
use vector::graphics::shape::Rectangle;
use vector::graphics::shape::Ring;

class Perbility extends vector::graphics::Builder {
    
    String color;
    
    int r;
    int dy;
    
    int f90;
    int f90n;
    int f270;
     
    [] __init() { this._initPerbility(); }
    [] _initPerbility() {
        _initSimpleBuilder(65);
        
        color = this.createStringFromCString("#e61c3e");
        
    }
    
    [Graphic] buildGraphic() {
        this._initializeCoordinates();
        
        Graphic graphic := this._newGraphic();
        
        Path heart := this._addNewFilledPath(graphic, color);
        
        this._generateHeart(heart);

        return graphic;
    }
    
    [] _generateHeart(Path heart) {
        this._heartLine1(heart, Flt:fromInt(-57), Flt:fromInt(37), Flt:fromInt(7));
        this._heartLine2(heart, Flt:fromInt(-39), Flt:fromInt(53), Flt:fromInt(6), Flt:fromInt(-14));
        this._heartLine2(heart, Flt:fromInt(-21), Flt:fromInt(42), Flt:fromInt(17), Flt:fromInt(-33));
        this._heartLine3(heart, Flt:ZERO_POS    , Flt:fromInt(30), Flt:fromInt(-9), Flt:fromInt(-34), Flt:fromInt(-53));
        this._heartLine2(heart, Flt:fromInt( 21), Flt:fromInt(42), Flt:ZERO_POS, Flt:fromInt(-33));
        this._heartLine2(heart, Flt:fromInt( 39), Flt:fromInt(53), Flt:fromInt(35), Flt:fromInt(-14));
        this._heartLine1(heart, Flt:fromInt( 57), Flt:fromInt(37), Flt:fromInt(7));
    }
    
    [] _heartLine1(Path heart, int cx, int cy1, int cy2) {
        this._addHeartLine(heart, cx, cy1, cy2);
    }
    
    [] _heartLine2(Path heart, int cx, int cy1, int cy2, int cy3) {
        this._addHeartLine(heart, cx, cy1, Flt:add(cy2, dy));
        this._addHeartLine(heart, cx, Flt:sub(cy2, dy), cy3);
    }
    
    [] _heartLine3(Path heart, int cx, int cy1, int cy2, int cy3, int cy4) {
        this._addHeartLine(heart, cx, cy1, Flt:add(cy2, dy));
        this._addHeartLine(heart, cx, Flt:sub(cy2, dy), Flt:add(cy3, dy));
        this._addHeartLine(heart, cx, Flt:sub(cy3, dy), cy4);
    }
    
    [] _addHeartLine(Path heart, int cx, int cy1, int cy2) {
        heart
            .arcFltTo(cx, cy1, r, f90n, f90, false)
            .arcFltTo(cx, cy2, r, f90, f270, true)
            .close();
    }
    
    [] _addScaffolding(Graphic g) {
        String c1 := scaffoldingColor1;
        String c2 := scaffoldingColor2;
        String c3 := scaffoldingColor3;
    }
    
    [] _initializeCoordinates() {
        r = Flt:fromInt(5);
        dy = Flt:fromInt(8);
        
        f90 = Flt:fromInt(90);
        f90n = Flt:fromInt(-90);
        f270 = Flt:fromInt(270);
    }

}
