/*[meta]
mimetype = text/x-pool
author = Marc Woerlein <marc.woerlein@gmx.de>
version = 0.1.0
*/
namespace vector::graphics::builder;

use sys::core::Flt;
use sys::core::String;

use vector::graphics::Graphic;
use vector::graphics::path::Path;
use vector::graphics::shape::PathShape;
use vector::graphics::shape::Rectangle;
use vector::graphics::shape::Ring;

class YinYang extends vector::graphics::Builder {
    
    String yinColor;
    String yangColor;
    String backgroundColor;
    
    int r1;
    int r3;
    int r3n;
    int r6;
    int f0;
    int f180;
    int f360;
    
     
    [] __init() { this._initYinYang(); }
    [] _initYinYang() {
        _initSimpleBuilder(70);
        
        yinColor = this.createStringFromCString("#111111");
        yangColor = this.createStringFromCString("#EEEEEE");
        yinColor = this.createStringFromCString("black");
        yangColor = this.createStringFromCString("white");
        backgroundColor = null;
        
    }
    
    [YinYang] light() {
        backgroundColor = yinColor;
        yinColor = null;
        return this;
    }
    
    [YinYang] dark() {
        backgroundColor = yangColor;
        yangColor = null;
        
        return this;
    }
    
    [Graphic] buildGraphic() {
        this._initializeCoordinates();
        
        Graphic graphic := this._newGraphic();
        
        if (backgroundColor) {
            this._styleFilledShape(
                graphic.addFltCircle(f0, f0, Flt:add(r6, Flt:div(r1, Flt:fromInt(6)))).shape(),
                backgroundColor
            );
        }
        Path yin := this._addNewFilledPath(graphic, yinColor);
        Path yang := this._addNewFilledPath(graphic, yangColor);
        
        this._generateYinYang(yin, yang);

        return graphic;
    }
    
    [] _generateYinYang(Path yin, Path yang) {
        yin
            .arcFltTo(f0, f0, r6, f0, f180, false)
            .arcFltTo(f0, r3n, r3, f180, f360, true)
            .arcFltTo(f0, r3, r3, f180, f0, true)
            .close();
        yin
            .circleFltTo(f0, r3, r1, false)
            .circleFltTo(f0, r3n, r1, false)
            .close();
        yang
            .arcFltTo(f0, f0, r6, f180, f360, false)
            .arcFltTo(f0, r3, r3, f0, f180, true)
            .arcFltTo(f0, r3n, r3, f360, f180, true)
            .close();
        yang
            .circleFltTo(f0, r3, r1, false)
            .circleFltTo(f0, r3n, r1, false)
            .close();
    }
    
    [] _addScaffolding(Graphic g) {
        String c1 := scaffoldingColor1;
        String c2 := scaffoldingColor2;
        String c3 := scaffoldingColor3;
        
        int xbl := Flt:sub(shiftX, viewWidth); 
        int xbr := Flt:add(shiftX, viewWidth);
        int ybu := Flt:add(shiftY, viewHeight);
        int ybd := Flt:sub(shiftY, viewHeight); 

        g.addFltRectangle(
            xbl, ybd,
            Flt:add(viewWidth, viewWidth), Flt:add(viewHeight, viewHeight)
        ).getStrokeStyle().setColor(c3);
        

        g.addFltCircle(f0, r3, r1).getStrokeStyle().setColor(c1);
        g.addFltCircle(f0, r3n, r1).getStrokeStyle().setColor(c1);
        g.addFltCircle(f0, r3, r3).getStrokeStyle().setColor(c1);
        g.addFltCircle(f0, r3n, r3).getStrokeStyle().setColor(c1);
        g.addFltCircle(f0, f0, r6).getStrokeStyle().setColor(c2);
        
    }
    
    [] _initializeCoordinates() {
        r1 = Flt:fromInt(10);
        r3 = Flt:fromInt(30);
        r3n = Flt:fromInt(-30);
        r6 = Flt:fromInt(60);
        
        f0 = Flt:ZERO_POS;
        f180 = Flt:fromInt(180);
        f360 = Flt:fromInt(360);
    }

}
