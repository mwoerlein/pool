mimetype = text/x-pool
author = Marc Woerlein <marc.woerlein@gmx.de>
version = 0.1.0
*/
namespace llm::layer;

use sys::core::Flt;
use sys::core::String;
use sys::core::math::FltVector;
use sys::core::math::FltMatrix;

class LinearLayerTest extends llm::test::TestCase {

    [] runAll() {
        this.testInitialization();
        this.testLinear();
    }
    
    [int] testInitialization() {
        this.start("testInitialization");

//        FltVector g3 = this.scaled3vec(1, 5,5,5);
//        FltVector b3 = this.scaled3vec(1, 1,1,1);
//        FltVector b2 = this.scaled2vec(1, 1,1);
        
        LinearLayer l = this.rt().createInstance(LinearLayer:CLASSNAME);
//        if (l._init(null, b2)) { return this.fail("Empty gamma initialization"); }
//        if (l._init(g3, null)) { return this.fail("Empty beta initialization"); }
//        if (l._init(g3, b2)) { return this.fail("Invalid initialization"); }
//        if (!this.isSame(l, l._init(g3, b3))) { return this.fail("Correct initialization"); }
        
        l.destroy();
//        b2.destroy();
        
        return this.success();
    }
    
    [int] testLinear() {
        this.startCases("testLinear");
        
        this.caseLinear(
            this.scaled3vec(1, 1,2,3),
            this.scaled23mat(1, 1,2,3, 4,5,6),
            this.scaled2vec(10, 5,-10),
            this.scaled2vec(10, 145,310)
        );
        this.caseLinear(
            this.scaled3vec(1, 2,3,-4),
            this.scaled13mat(1, -1,-2,0),
            this.scaled1vec(1, 0),
            this.scaled1vec(1, -8)
        );
        this.caseLinear(
            this.scaled3vec(1, 1,2,3),
            this.scaled33mat(1, 1,0,0, 0,1,0, 0,0,1),
            this.scaled3vec(1, 5,-2,7),
            this.scaled3vec(1, 6,0,10)
        );
        this.caseLinear(
            this.scaled3vec(1, 0,0,0),
            this.scaled23mat(1, 1,2,3, 4,5,6),
            this.scaled2vec(10, 1,2),
            this.scaled2vec(10, 1,2)
        );
        this.caseLinear(
            this.scaled2vec(1, 3,4),
            this.scaled32mat(1, 1,0, 0,1, 2,2),
            this.scaled3vec(1, 0,0,0),
            this.scaled3vec(1, 3,4,14)
        );
        this.caseLinear(
            this.scaled3vec(1, 1,1,2),
            this.scaled13mat(1, 1000,1000,-1000),
            this.scaled1vec(1, 0),
            this.scaled1vec(1, 0)
        );
        this.caseLinear(
            this.scaled3vec(1, 1,1,-2),
            this.scaled13mat(1, 1000,1000,-1000),
            this.scaled1vec(1, 0),
            this.scaled1vec(1, 4000)
        );
        
        return this.successCases();
    }

    [int] caseLinear(FltVector x, FltMatrix w, FltVector b, FltVector expected) {

        LinearLayer l = this.rt().createInstance(LinearLayer:CLASSNAME);
        FltVector y = l._init(w, b).forward(x);
        
        String message = this.rt().createInstance(String:CLASSNAME);
        message.printCString("Case ").print(x)
            .printCString(" w ").print(w)
            .printCString(" b ").print(b)
            .printCString(" => ").print(expected);
        if (!y) {
            message.printCString(" has no result");
            return this.failCase(message.ostream());
        }
        if (expected.compareFltVector(y) != 0)  {
            message.printCString(" got ").print(y);
            y.debugToStream(message.printCString(" "));
            return this.failCase(message.ostream());
        }
        
        message.destroy();
        y.destroy();
        l.destroy();
        expected.destroy();
        x.destroy();
        return this.successCase();        
    }
    
}
