/*[meta]
mimetype = text/x-pool
author = Marc Woerlein <marc.woerlein@gmx.de>
version = 0.1.0
*/
namespace llm::layer;

use sys::core::Flt;
use sys::core::String;
use sys::core::math::FltVector;

class SoftmaxLayerTest extends llm::test::TestCase {

    [] runAll() {
        this.testInitialization();
        this.testSoftmax();
    }
    
    [int] testInitialization() {
        this.start("testInitialization");

        SoftmaxLayer l = this.rt().createInstance(SoftmaxLayer:CLASSNAME);
        l.destroy();
        
        return this.success();
    }
    
    [int] testSoftmax() {
        this.startCases("testSoftmax");
        
        this.caseSoftmax(
            this.scaled3vec(10, 20,10,1),
            this.flt3vec(0x3f28b44c,0x3e78405a,0x3dc9dcea)
        );
        this.caseSoftmax(
            this.scaled3vec(1, 1,1,1),
            this.scaled3vec(3, 1,1,1)
        );
        this.caseSoftmax(
            this.scaled3vec(1, -1,0,1),
            this.flt3vec(0x3db861f3,0x3e7a9a1a,0x3f2a4d3b)
        );
        this.caseSoftmax(
            this.scaled2vec(1, 1000,1000),
            this.scaled2vec(10, 5,5)
        );
        this.caseSoftmax(
            this.scaled2vec(1, 1000,-1000),
            this.scaled2vec(1, 1,0)
        );
        this.caseSoftmax(
            this.scaled2vec(1, 0,0),
            this.scaled2vec(10, 5,5)
        );
        this.caseSoftmax(
            this.scaled1vec(1, 42),
            this.scaled1vec(1, 1)
        );
        
        return this.successCases();        
    }
    
    [int] caseSoftmax(FltVector x, FltVector expected) {

        String message = this.rt().createInstance(String:CLASSNAME);
        message.printCString("Case ").print(x).printCString(" => ").print(expected);
        
        SoftmaxLayer l = this.rt().createInstance(SoftmaxLayer:CLASSNAME);
        
        FltVector y = l.forward(x);
        if (!y) {
            message.printCString(" has no result");
            return this.failCase(message.ostream());
        }
        if (expected.compareFltVector(y) != 0)  {
            message.printCString(" got ").print(y);
            y.debugToStream(message.printCString(" "));
            return this.failCase(message.ostream());
        }
        if (Flt:compare(y.sum(), Flt:ONE_POS) != 0) {
            message.printCString(" doesn't normalize to 100%");
            return this.failCase(message.ostream());
        }
        
        y.destroy();
        l.destroy();
        message.destroy();
        expected.destroy();
        x.destroy();
        return this.successCase();        
    }

}
