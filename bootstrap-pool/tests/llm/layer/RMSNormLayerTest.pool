/*[meta]
mimetype = text/x-pool
author = Marc Woerlein <marc.woerlein@gmx.de>
version = 0.1.0
*/
namespace llm::layer;

use sys::core::Flt;
use sys::core::String;
use sys::core::math::FltVector;

class RMSNormLayerTest extends llm::test::TestCase {

    [] runAll() {
        this.testInitialization();
        this.testRMSNorm();
    }
    
    [int] testInitialization() {
        this.start("testInitialization");

        FltVector g3 = this.scaled3vec(1, 5,5,5);
        
        RMSNormLayer l = this.rt().createInstance(RMSNormLayer:CLASSNAME);
        if (l._init(null, Flt:ONE_HUNDRED_THOUSANDTH_POS)) { return this.fail("Empty gamma initialization"); }
        if (!this.isSame(l, l._init(g3, Flt:ONE_HUNDRED_THOUSANDTH_POS))) { return this.fail("Correct initialization"); }
        
        l.destroy();
        
        return this.success();
    }
    
    [int] testRMSNorm() {
        this.startCases("testRMSNorm");
        
        this.caseRMSNorm(
            this.scaled4vec(1, 2,-1,3,0),
            this.scaled4vec(10, 10,5,2,11),
            this.flt4vec(0x3f88d66a,0xbe88d66a,0x3ea43480,0x00000000)
        );
        this.caseRMSNorm(
            this.scaled3vec(1, 0,0,0),
            this.scaled3vec(1, 1,1,1),
            this.scaled3vec(1, 0,0,0)
        );
        this.caseRMSNorm(
            this.scaled2vec(10000000, 1,-1),
            this.scaled2vec(1, 1,1),
            this.flt2vec(0x3804a2b3,0xb804a2b3)
        );
        
        return this.successCases();
    }
    
    [int] caseRMSNorm(FltVector x, FltVector gamma, FltVector expected) {

        String message = this.rt().createInstance(String:CLASSNAME);
        message.printCString("Case ").print(x)
            .printCString(" gamma ").print(gamma)
            .printCString(" => ").print(expected);

        RMSNormLayer l = this.rt().createInstance(RMSNormLayer:CLASSNAME);
        if (!this.isSame(l, l._init(gamma, Flt:ONE_HUNDRED_THOUSANDTH_POS))) {
            message.printCString(" has invalid settings");
            return this.failCase(message.ostream());
        }

        FltVector y = l.forwardVector(x);
        if (!y) {
            message.printCString(" has no result");
            return this.failCase(message.ostream());
        }
        if (expected.compareFltVector(y) != 0)  {
            message.printCString(" got ").print(y);
            y.debugToStream(message.printCString(" "));
            return this.failCase(message.ostream());
        }
        
        y.destroy();
        l.destroy();
        message.destroy();
        expected.destroy();
        x.destroy();
        return this.successCase();        
    }

}
