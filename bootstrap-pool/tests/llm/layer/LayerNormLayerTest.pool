/*[meta]
mimetype = text/x-pool
author = Marc Woerlein <marc.woerlein@gmx.de>
version = 0.1.0
*/
namespace llm::layer;

use sys::core::Flt;
use sys::core::String;
use sys::core::math::FltVector;

class LayerNormLayerTest extends llm::test::TestCase {

    [] runAll() {
        this.testInitialization();
        this.testLayerNorm();
    }
    
    [int] testInitialization() {
        this.start("testInitialization");

        FltVector g3 = this.scaled3vec(1, 5,5,5);
        FltVector b3 = this.scaled3vec(1, 1,1,1);
        FltVector b2 = this.scaled2vec(1, 1,1);
        
        LayerNormLayer l = this.rt().createInstance(LayerNormLayer:CLASSNAME);
        if (l._init(null, b2)) { return this.fail("Empty gamma initialization"); }
        if (l._init(g3, null)) { return this.fail("Empty beta initialization"); }
        if (l._init(g3, b2)) { return this.fail("Invalid initialization"); }
        if (!this.isSame(l, l._init(g3, b3))) { return this.fail("Correct initialization"); }
        
        l.destroy();
        b2.destroy();
        
        return this.success();
    }
    
    [int] testLayerNorm() {
        this.startCases("testLayerNorm");
        
        this.caseLayerNorm(
            this.scaled3vec(1, 1,2,3),
            this.scaled3vec(1, 1,1,1),
            this.scaled3vec(1, 0,0,0),
            this.flt3vec(0xbf9cc16e,0x00000000,0x3f9cc16e)
        );
        this.caseLayerNorm(
            this.scaled3vec(1, 5,5,5),
            this.scaled3vec(1, 1,1,1),
            this.scaled3vec(1, 0,0,0),
            this.flt3vec(0x00000000,0x00000000,0x00000000)
        );
        this.caseLayerNorm(
            this.scaled3vec(1, -1,2,3),
            this.scaled3vec(1, 1,1,1),
            this.scaled3vec(1, 0,0,0),
            this.flt3vec(0xbfafb78f,0x3ec8d1c6,0x3f7b0638)
        );
        this.caseLayerNorm(
            this.scaled3vec(1, 0,100,0),
            this.scaled3vec(1, 1,1,1),
            this.scaled3vec(1, 0,0,0),
            this.flt3vec(0xbf3504f1,0x3fb504f3,0xbf3504f1)
        );
        this.caseLayerNorm(
            this.scaled3vec(1, 1,2,3),
            this.scaled3vec(1, 2,2,2),
            this.scaled3vec(1, 1,1,1),
            this.flt3vec(0xbfb982dc,0x3f800000,0x405cc16e)
        );
        this.caseLayerNorm(
            this.scaled3vec(1, 1,2,3),
            this.scaled3vec(10, 5,10,20),
            this.scaled3vec(10, 0,1,0),
            this.flt3vec(0xbf1cc16e,0x3dcccccd,0x401cc16e)
        );
        
        return this.successCases();
    }
    
    [int] caseLayerNorm(FltVector x, FltVector gamma, FltVector beta, FltVector expected) {

        LayerNormLayer l = this.rt().createInstance(LayerNormLayer:CLASSNAME);
        FltVector y = l._init(gamma, beta).forward(x);
        
        String message = this.rt().createInstance(String:CLASSNAME);
        message.printCString("Case ").print(x)
            .printCString(" gamma ").print(gamma)
            .printCString(" beta ").print(beta)
            .printCString(" => ").print(expected);
        if (!y) {
            message.printCString(" has no result");
            return this.failCase(message.ostream());
        }
        if (expected.compareFltVector(y) != 0)  {
            message.printCString(" got ").print(y);
            y.debugToStream(message.printCString(" "));
            return this.failCase(message.ostream());
        }
        
        message.destroy();
        y.destroy();
        l.destroy();
        expected.destroy();
        x.destroy();
        return this.successCase();        
    }

}
