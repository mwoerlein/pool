/*[meta]
mimetype = text/x-pool
author = Marc Woerlein <marc.woerlein@gmx.de>
version = 0.1.0
*/
namespace llm::layer;

use sys::core::Flt;
use sys::core::String;
use sys::core::math::FltVector;
use sys::core::math::FltMatrix;

class ReLUFeedForwardLayerTest extends llm::test::TestCase {

    [] runAll() {
        this.testInitialization();
        this.testReLUFeedForwardLayer();
    }
    
    [int] testInitialization() {
        this.start("testInitialization");

        FltMatrix w23 = this.scaled23mat(1, 5,5,5, 6,6,6);
        FltMatrix w32 = this.scaled32mat(1, 4,4, 5,5, 6,6);
        FltVector b3 = this.scaled3vec(1, 1,1,1);
        FltVector b2 = this.scaled2vec(1, 1,1);
        
        ReLUFeedForwardLayer l = this.rt().createInstance(ReLUFeedForwardLayer:CLASSNAME);
        if (l._init(null, b3, w32, b2)) { return this.fail("Empty w1 initialization"); }
        if (l._init(w23, null, w32, b2)) { return this.fail("Empty b1 initialization"); }
        if (l._init(w23, b3, null, b2)) { return this.fail("Empty w2 initialization"); }
        if (l._init(w23, b3, w32, null)) { return this.fail("Empty b2 initialization"); }
        if (l._init(w23, b2, w32, b2)) { return this.fail("Invalid b1 initialization"); }
        if (l._init(w23, b2, w32, b2)) { return this.fail("Invalid b2 initialization"); }
        if (l._init(w23, b3, w23, b3)) { return this.fail("Invalid w1 initialization"); }
        if (!this.isSame(l, l._init(w23, b3, w32, b2))) { return this.fail("Correct initialization"); }
        
        l.destroy();
        
        return this.success();
    }
    
    [int] testReLUFeedForwardLayer() {
        this.startCases("testReLUFeedForwardLayer");
        
        this.caseReLUFeedForwardLayer(
            this.scaled2vec(1, 1,2),
            this.scaled23mat(1, 1,0,1, 2,1,0),
            this.scaled3vec(1, 0,0,0),
            this.scaled32mat(1, 1,0, 1,1, 1,0),
            this.scaled2vec(1, 0,0),
            this.scaled2vec(1, 8,2)
        );
        this.caseReLUFeedForwardLayer(
            this.scaled2vec(1, 1,2),
            this.scaled23mat(10, 5,10,25, -10,20,-5),
            this.scaled3vec(10, 1,-2,3),
            this.scaled32mat(10, 10,-10, 0,10, 20,5),
            this.scaled2vec(10, 5,-10),
            this.flt2vec(0x40833333,0x40966667)
        );
        this.caseReLUFeedForwardLayer(
            this.scaled2vec(1, 0,0),
            this.scaled23mat(10, 5,10,25, -10,20,-5),
            this.scaled3vec(10, 1,-2,3),
            this.scaled32mat(10, 10,-10, 0,10, 20,5),
            this.scaled2vec(10, 5,-10),
            this.scaled2vec(100, 120,-95)
        );
        this.caseReLUFeedForwardLayer(
            this.scaled2vec(1, -1,-1),
            this.scaled23mat(1, 1,0,1, 2,1,0),
            this.scaled3vec(1, 0,0,0),
            this.scaled32mat(1, 1,0, 1,1, 1,0),
            this.scaled2vec(1, 0,0),
            this.scaled2vec(1, 0,0)
        );
        this.caseReLUFeedForwardLayer(
            this.scaled2vec(1, 1000000,-1000000),
            this.scaled23mat(1, 1,0,1, 2,1,0),
            this.scaled3vec(1, 0,0,0),
            this.scaled32mat(1, 1,0, 1,1, 1,0),
            this.scaled2vec(1, 0,0),
            this.scaled2vec(1, 1000000,0)
        );
        
        return this.successCases();
    }
    
    [int] caseReLUFeedForwardLayer(FltVector x, FltMatrix w1, FltVector b1, FltMatrix w2, FltVector b2, FltVector expected) {
        
        String message = this.rt().createInstance(String:CLASSNAME);
        message.printCString("Case ").print(x)
            .printCString(" w1 ").print(w1)
            .printCString(" b1 ").print(b1)
            .printCString(" w2 ").print(w2)
            .printCString(" b2 ").print(b2)
            .printCString(" => ").print(expected);
        expected.debugToStream(message.printCString(" "));

        ReLUFeedForwardLayer l = this.rt().createInstance(ReLUFeedForwardLayer:CLASSNAME);
        if (!this.isSame(l, l._init(w1, b1, w2, b2))) {
            message.printCString(" has invalid settings");
            return this.failCase(message.ostream());
        }
        FltVector y = l.forwardVector(x);
        if (!y) {
            message.printCString(" has no result");
            return this.failCase(message.ostream());
        }
        if (expected.compareFltVector(y) != 0)  {
            message.printCString(" got ").print(y);
            y.debugToStream(message.printCString(" "));
            return this.failCase(message.ostream());
        }
        
        message.destroy();
        y.destroy();
        l.destroy();
        expected.destroy();
        x.destroy();
        return this.successCase();        
    }
    
}
