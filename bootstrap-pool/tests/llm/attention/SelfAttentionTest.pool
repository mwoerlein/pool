/*[meta]
mimetype = text/x-pool
author = Marc Woerlein <marc.woerlein@gmx.de>
version = 0.1.0
*/
namespace llm::attention;

use sys::core::Flt;
use sys::core::String;
use sys::core::math::FltVector;
use sys::core::math::FltMatrix;

class SelfAttentionTest extends llm::test::TestCase {

    [] runAll() {
        this.testInitialization();
        this.testSelfAttention();
        this.testCausalMask();
    }
    
    [int] testInitialization() {
        this.start("testInitialization");

        FltMatrix wq = this.scaled32mat(1, 1,1, 2,2, 3,3);
        FltMatrix wk = this.scaled32mat(1, 3,3, 4,4, 5,5);
        FltMatrix wv = this.scaled32mat(1, 5,5, 6,6, 7,7);
        FltMatrix wi = this.scaled23mat(1, 1,2,3, 4,5,6);
        FltVector bq = this.scaled2vec(1, 0,0);
        FltVector bk = this.scaled2vec(1, 1,1);
        FltVector bv = this.scaled2vec(1, 2,2);
        FltVector bi = this.scaled3vec(1, 1,1,1);
        
        SelfAttention a = this.rt().createInstance(SelfAttention:CLASSNAME);
        
        if (a._init(null, bq, wk, bk, wv, bv)) { return this.fail("Empty wq initialization"); }
        if (a._init(wq, null, wk, bk, wv, bv)) { return this.fail("Empty bq initialization"); }
        if (a._init(wq, bq, null, bk, wv, bv)) { return this.fail("Empty wk initialization"); }
        if (a._init(wq, bq, wk, null, wv, bv)) { return this.fail("Empty bk initialization"); }
        if (a._init(wq, bq, wk, bk, null, bv)) { return this.fail("Empty wv initialization"); }
        if (a._init(wq, bq, wk, bk, wv, null)) { return this.fail("Empty bv initialization"); }
        
        if (a._init(wi, bq, wk, bk, wv, bv)) { return this.fail("Invalid wq initialization"); }
        if (a._init(wq, bi, wk, bk, wv, bv)) { return this.fail("Invalid bq initialization"); }
        if (a._init(wq, bq, wi, bk, wv, bv)) { return this.fail("Invalid wk initialization"); }
        if (a._init(wq, bq, wk, bi, wv, bv)) { return this.fail("Invalid bk initialization"); }
        if (a._init(wq, bq, wk, bk, wi, bv)) { return this.fail("Invalid wv initialization"); }
        if (a._init(wq, bq, wk, bk, wv, bi)) { return this.fail("Invalid bv initialization"); }
        
        if (!this.isSame(a, a._init(wq, bq, wk, bk, wv, bv))) { return this.fail("Correct initialization"); }
        
        a.destroy();
        bi.destroy();
        wi.destroy();
        
        return this.success();
    }
    
    [int] testSelfAttention() {
        this.startCases("testSelfAttention");
        
        this.caseSelfAttention(
            this.scaled23mat(1, 1,0,0, 0,1,0),
            this.scaled32mat(1, 1,0, 0,1, 0,0),
            this.scaled2vec(1, 0,0),
            this.scaled32mat(1, 0,0, 1,0, 0,1),
            this.scaled2vec(1, 0,0),
            this.scaled32mat(1, 1,0, 0,1, 1,0),
            this.scaled2vec(1, 0,0),
            this.scaled22mat(10, 10,0, 5,5)
        );
        this.caseSelfAttention(
            this.scaled23mat(1, 1,0,0, 1,0,0),
            this.scaled33mat(1, 1,0,0, 0,1,0, 0,0,1),
            this.scaled3vec(1, 0,0,0),
            this.scaled33mat(1, 1,0,0, 0,1,0, 0,0,1),
            this.scaled3vec(1, 0,0,0),
            this.scaled33mat(1, 1,0,0, 0,1,0, 0,0,1),
            this.scaled3vec(1, 0,0,0),
            this.scaled23mat(1, 1,0,0, 1,0,0)
        );
        this.caseSelfAttention(
            this.scaled23mat(1, 0,0,0, 0,0,0),
            this.scaled33mat(1, 1,0,0, 0,1,0, 0,0,1),
            this.scaled3vec(1, 0,0,0),
            this.scaled33mat(1, 1,0,0, 0,1,0, 0,0,1),
            this.scaled3vec(1, 0,0,0),
            this.scaled33mat(1, 1,0,0, 0,1,0, 0,0,1),
            this.scaled3vec(1, 0,0,0),
            this.scaled23mat(1, 0,0,0, 0,0,0)
        );
        this.caseSelfAttention(
            this.scaled13mat(1, 1,0,0),
            this.scaled33mat(1, 1,0,0, 0,1,0, 0,0,1),
            this.scaled3vec(1, 0,0,0),
            this.scaled33mat(1, 1,0,0, 0,1,0, 0,0,1),
            this.scaled3vec(1, 0,0,0),
            this.scaled33mat(1, 1,0,0, 0,1,0, 0,0,1),
            this.scaled3vec(1, 0,0,0),
            this.scaled13mat(1, 1,0,0)
        );
        
        return this.successCases();
    }

    
    [int] caseSelfAttention(FltMatrix x, FltMatrix wq, FltVector bq, FltMatrix wk, FltVector bk, FltMatrix wv, FltVector bv, FltMatrix expected) {

        String message = this.rt().createInstance(String:CLASSNAME);
        message.printCString("Case ").print(x)
            .printCString(" wq ").print(wq)
            .printCString(" bq ").print(bq)
            .printCString(" wk ").print(wk)
            .printCString(" bk ").print(bk)
            .printCString(" wv ").print(wv)
            .printCString(" bv ").print(bv)
            .printCString(" => ").print(expected);

        SelfAttention a = this.rt().createInstance(SelfAttention:CLASSNAME);
        if (!this.isSame(a, a._init(wq, bq, wk, bk, wv, bv))) {
            message.printCString(" has invalid settings");
            return this.failCase(message.ostream());
        }
        
        FltMatrix y = a.forwardMatrix(x);
        if (!y) {
            message.printCString(" has no result");
            return this.failCase(message.ostream());
        }
        if (expected.compareFltMatrix(y) != 0)  {
            message.printCString(" got ").print(y);
            y.debugToStream(message.printCString(" "));
            return this.failCase(message.ostream());
        }
        
        y.destroy();
        a.destroy();
        message.destroy();
        expected.destroy();
        x.destroy();
        return this.successCase();        
    }
    
    [int] testCausalMask() {
        this.start("testCausalMask");

        FltMatrix m = this.scaled33mat(1, 0,1,2, 0,1,2, 0,1,2);
        
        SelfAttention:applyCausalMask(m);
        
        if (Flt:compare(m.get(0,0), Flt:ZERO_POS) != 0) { return this.fail("Causal mask keep 0,0"); }
        if (Flt:compare(m.get(0,1), SelfAttention:MASK_FLT) != 0) { return this.fail("Causal mask hide 0,1"); }
        if (Flt:compare(m.get(0,2), SelfAttention:MASK_FLT) != 0) { return this.fail("Causal mask hide 0,2"); }
        if (Flt:compare(m.get(1,0), Flt:ZERO_POS) != 0) { return this.fail("Causal mask keep 1,0"); }
        if (Flt:compare(m.get(1,1), Flt:ONE_POS) != 0) { return this.fail("Causal mask keep 1,1"); }
        if (Flt:compare(m.get(1,2), SelfAttention:MASK_FLT) != 0) { return this.fail("Causal mask hide 1,2"); }
        if (Flt:compare(m.get(2,0), Flt:ZERO_POS) != 0) { return this.fail("Causal mask keep 2,0"); }
        if (Flt:compare(m.get(2,1), Flt:ONE_POS) != 0) { return this.fail("Causal mask keep 2,1"); }
        if (Flt:compare(m.get(2,2), Flt:TWO_POS) != 0) { return this.fail("Causal mask keep 2,2"); }
        
        m.destroy();
        
        return this.success();
    }
    
}
