/*[meta]
mimetype = text/x-pool
author = Marc Woerlein <marc.woerlein@gmx.de>
version = 0.1.0
*/
namespace llm::test;

use sys::core::Flt;
use sys::core::String;
use sys::core::math::FltVector;
use sys::core::math::FltMatrix;
use sys::stream::IStream;

class TestCase extends test::TestCase {
    
    [FltVector] scaled1vec(int dividend, int a) {
        FltVector v = this.rt().createInstance(FltVector:CLASSNAME);
        v.init(1);
        v.set(0, Flt:fromInt(a));
        v.divFlt(Flt:fromInt(dividend));
        return v;
    }
    
    [FltVector] scaled2vec(int dividend, int a, int b) {
        FltVector v = this.rt().createInstance(FltVector:CLASSNAME);
        v.init(2);
        v.set(0, Flt:fromInt(a)); v.set(1, Flt:fromInt(b));
        v.divFlt(Flt:fromInt(dividend));
        return v;
    }
    
    [FltVector] scaled3vec(int scale, int a, int b, int c) {
        FltVector v = this.rt().createInstance(FltVector:CLASSNAME);
        v.init(3);
        v.set(0, Flt:fromInt(a)); v.set(1, Flt:fromInt(b)); v.set(2, Flt:fromInt(c));
        v.divFlt(Flt:fromInt(scale));
        return v;
    }
    
    [FltVector] scaled4vec(int scale, int a, int b, int c, int d) {
        FltVector v = this.rt().createInstance(FltVector:CLASSNAME);
        v.init(4);
        v.set(0, Flt:fromInt(a)); v.set(1, Flt:fromInt(b)); v.set(2, Flt:fromInt(c)); v.set(3, Flt:fromInt(d));
        v.divFlt(Flt:fromInt(scale));
        return v;
    }
    
    [FltVector] flt1vec(int a) {
        FltVector v = this.rt().createInstance(FltVector:CLASSNAME);
        v.init(1);
        v.set(0, a);
        return v;
    }
    
    [FltVector] flt2vec(int a, int b) {
        FltVector v = this.rt().createInstance(FltVector:CLASSNAME);
        v.init(2);
        v.set(0, a); v.set(1, b);
        return v;
    }
    
    [FltVector] flt3vec(int a, int b, int c) {
        FltVector v = this.rt().createInstance(FltVector:CLASSNAME);
        v.init(3);
        v.set(0, a); v.set(1, b); v.set(2, c);
        return v;
    }

    
    [FltMatrix] scaled13mat(int scale, int m00, int m01, int m02) {
        FltMatrix m = this.rt().createInstance(FltMatrix:CLASSNAME);
        m.init(1, 3);
        m.set(0, 0, Flt:fromInt(m00)); m.set(0, 1, Flt:fromInt(m01)); m.set(0, 2, Flt:fromInt(m02));
        m.divFlt(Flt:fromInt(scale));
        return m;
    }
    
    [FltMatrix] scaled14mat(int scale, int m00, int m01, int m02, int m03) {
        FltMatrix m = this.rt().createInstance(FltMatrix:CLASSNAME);
        m.init(1, 4);
        m.set(0, 0, Flt:fromInt(m00)); m.set(0, 1, Flt:fromInt(m01)); m.set(0, 2, Flt:fromInt(m02)); m.set(0, 3, Flt:fromInt(m03));
        m.divFlt(Flt:fromInt(scale));
        return m;
    }
    
    [FltMatrix] scaled21mat(int scale, int m00, int m10) {
        FltMatrix m = this.rt().createInstance(FltMatrix:CLASSNAME);
        m.init(2, 1);
        m.set(0, 0, Flt:fromInt(m00));
        m.set(1, 0, Flt:fromInt(m10));
        m.divFlt(Flt:fromInt(scale));
        return m;
    }
    
    [FltMatrix] scaled22mat(int scale, int m00, int m01, int m10, int m11) {
        FltMatrix m = this.rt().createInstance(FltMatrix:CLASSNAME);
        m.init(2, 2);
        m.set(0, 0, Flt:fromInt(m00)); m.set(0, 1, Flt:fromInt(m01));
        m.set(1, 0, Flt:fromInt(m10)); m.set(1, 1, Flt:fromInt(m11));
        m.divFlt(Flt:fromInt(scale));
        return m;
    }
    
    [FltMatrix] scaled23mat(int scale, int m00, int m01, int m02, int m10, int m11, int m12) {
        FltMatrix m = this.rt().createInstance(FltMatrix:CLASSNAME);
        m.init(2, 3);
        m.set(0, 0, Flt:fromInt(m00)); m.set(0, 1, Flt:fromInt(m01)); m.set(0, 2, Flt:fromInt(m02));
        m.set(1, 0, Flt:fromInt(m10)); m.set(1, 1, Flt:fromInt(m11)); m.set(1, 2, Flt:fromInt(m12));
        m.divFlt(Flt:fromInt(scale));
        return m;
    }
    
    [FltMatrix] scaled24mat(int scale, int m00, int m01, int m02, int m03, int m10, int m11, int m12, int m13) {
        FltMatrix m = this.rt().createInstance(FltMatrix:CLASSNAME);
        m.init(2, 4);
        m.set(0, 0, Flt:fromInt(m00)); m.set(0, 1, Flt:fromInt(m01)); m.set(0, 2, Flt:fromInt(m02)); m.set(0, 3, Flt:fromInt(m03));
        m.set(1, 0, Flt:fromInt(m10)); m.set(1, 1, Flt:fromInt(m11)); m.set(1, 2, Flt:fromInt(m12)); m.set(1, 3, Flt:fromInt(m13));
        m.divFlt(Flt:fromInt(scale));
        return m;
    }
    
    [FltMatrix] scaled31mat(int scale, int m00, int m10, int m20) {
        FltMatrix m = this.rt().createInstance(FltMatrix:CLASSNAME);
        m.init(3, 1);
        m.set(0, 0, Flt:fromInt(m00));
        m.set(1, 0, Flt:fromInt(m10));
        m.set(2, 0, Flt:fromInt(m20));
        m.divFlt(Flt:fromInt(scale));
        return m;
    }
    
    [FltMatrix] scaled32mat(int scale, int m00, int m01, int m10, int m11, int m20, int m21) {
        FltMatrix m = this.rt().createInstance(FltMatrix:CLASSNAME);
        m.init(3, 2);
        m.set(0, 0, Flt:fromInt(m00)); m.set(0, 1, Flt:fromInt(m01));
        m.set(1, 0, Flt:fromInt(m10)); m.set(1, 1, Flt:fromInt(m11));
        m.set(2, 0, Flt:fromInt(m20)); m.set(2, 1, Flt:fromInt(m21));
        m.divFlt(Flt:fromInt(scale));
        return m;
    }
    
    [FltMatrix] scaled33mat(int scale, int m00, int m01, int m02, int m10, int m11, int m12, int m20, int m21, int m22) {
        FltMatrix m = this.rt().createInstance(FltMatrix:CLASSNAME);
        m.init(3, 3);
        m.set(0, 0, Flt:fromInt(m00)); m.set(0, 1, Flt:fromInt(m01)); m.set(0, 2, Flt:fromInt(m02));
        m.set(1, 0, Flt:fromInt(m10)); m.set(1, 1, Flt:fromInt(m11)); m.set(1, 2, Flt:fromInt(m12));
        m.set(2, 0, Flt:fromInt(m20)); m.set(2, 1, Flt:fromInt(m21)); m.set(2, 2, Flt:fromInt(m22));
        m.divFlt(Flt:fromInt(scale));
        return m;
    }
    
    [FltMatrix] scaled34mat(int scale, int m00, int m01, int m02, int m03, int m10, int m11, int m12, int m13, int m20, int m21, int m22, int m23) {
        FltMatrix m = this.rt().createInstance(FltMatrix:CLASSNAME);
        m.init(3, 4);
        m.set(0, 0, Flt:fromInt(m00)); m.set(0, 1, Flt:fromInt(m01)); m.set(0, 2, Flt:fromInt(m02)); m.set(0, 3, Flt:fromInt(m03));
        m.set(1, 0, Flt:fromInt(m10)); m.set(1, 1, Flt:fromInt(m11)); m.set(1, 2, Flt:fromInt(m12)); m.set(1, 3, Flt:fromInt(m13));
        m.set(2, 0, Flt:fromInt(m20)); m.set(2, 1, Flt:fromInt(m21)); m.set(2, 2, Flt:fromInt(m22)); m.set(2, 3, Flt:fromInt(m23));
        m.divFlt(Flt:fromInt(scale));
        return m;
    }
    
    [FltMatrix] scaled44mat(int scale,
        int m00, int m01, int m02, int m03,
        int m10, int m11, int m12, int m13,
        int m20, int m21, int m22, int m23,
        int m30, int m31, int m32, int m33
    ) {
        FltMatrix m = this.rt().createInstance(FltMatrix:CLASSNAME);
        m.init(4, 4);
        m.set(0, 0, Flt:fromInt(m00)); m.set(0, 1, Flt:fromInt(m01)); m.set(0, 2, Flt:fromInt(m02)); m.set(0, 3, Flt:fromInt(m03));
        m.set(1, 0, Flt:fromInt(m10)); m.set(1, 1, Flt:fromInt(m11)); m.set(1, 2, Flt:fromInt(m12)); m.set(1, 3, Flt:fromInt(m13));
        m.set(2, 0, Flt:fromInt(m20)); m.set(2, 1, Flt:fromInt(m21)); m.set(2, 2, Flt:fromInt(m22)); m.set(2, 3, Flt:fromInt(m23));
        m.set(3, 0, Flt:fromInt(m30)); m.set(3, 1, Flt:fromInt(m31)); m.set(3, 2, Flt:fromInt(m32)); m.set(3, 3, Flt:fromInt(m33));
        m.divFlt(Flt:fromInt(scale));
        return m;
    }
    
    
    [FltMatrix] flt22mat(int m00, int m01, int m10, int m11) {
        FltMatrix m = this.rt().createInstance(FltMatrix:CLASSNAME);
        m.init(2, 2);
        m.set(0, 0, m00); m.set(0, 1, m01);
        m.set(1, 0, m10); m.set(1, 1, m11);
        return m;
    }
    [FltMatrix] flt24mat(int m00, int m01, int m02, int m03, int m10, int m11, int m12, int m13) {
        FltMatrix m = this.rt().createInstance(FltMatrix:CLASSNAME);
        m.init(2, 4);
        m.set(0, 0, m00); m.set(0, 1, m01); m.set(0, 2, m02); m.set(0, 3, m03);
        m.set(1, 0, m10); m.set(1, 1, m11); m.set(1, 2, m12); m.set(1, 3, m13);
        return m;
    }
}
