/*[meta]
mimetype = text/x-pool
author = Marc Woerlein <marc.woerlein@gmx.de>
version = 0.1.0
*/
namespace llm;

class __Tests__ {
    
    global [] setup(test::TestSuite suite) {
        
        suite.register(llm::attention::SelfAttention:CLASSNAME, llm::attention::SelfAttentionTest:CLASSNAME);
        suite.register(llm::attention::MultiHeadAttention:CLASSNAME, llm::attention::MultiHeadAttentionTest:CLASSNAME);
        
        suite.register(llm::layer::EncoderLayer:CLASSNAME, llm::layer::EncoderLayerTest:CLASSNAME);
        
        suite.register(llm::layer::FeedForwardLayer:CLASSNAME, llm::layer::FeedForwardLayerTest:CLASSNAME);
        suite.register(llm::layer::LayerNormLayer:CLASSNAME, llm::layer::LayerNormLayerTest:CLASSNAME);
        suite.register(llm::layer::LinearLayer:CLASSNAME, llm::layer::LinearLayerTest:CLASSNAME);
        suite.register(llm::layer::SoftmaxLayer:CLASSNAME, llm::layer::SoftmaxLayerTest:CLASSNAME);
        
        suite.register(llm::EmbeddingWithPositionalEncoding:CLASSNAME, llm::EmbeddingWithPositionalEncodingTest:CLASSNAME);
        
    }
}
