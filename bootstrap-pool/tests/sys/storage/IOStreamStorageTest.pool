/*[meta]
mimetype = text/x-pool
author = Marc Woerlein <marc.woerlein@gmx.de>
version = 0.1.0
*/
namespace sys::storage;

use pool::storage::StoreBuilder;

use sys::core::String;
use sys::core::anycollection::AnyIterator;
use sys::memory::MemoryIOStream;
use sys::stream::SeekableIOStream;

class IOStreamStorageTest extends test::TestCase {

    [] runAll() {
        this.testIOStreamStorageElements();
    }

    [int] testIOStreamStorageElements() {
        this.start("testIOStreamStorageElements");
        
        SeekableIOStream storeStream := this._createBufferStream(1024);
        this._initStoreStream(storeStream, 2, true)
            .addElement(this._createContentFromCString("/*[pool]\nname = my::TestClass1\n*/\ncontent1"))
            .addElement(this._createContentFromCString("/*[pool]\nname = my::TestClass2\n*/\ncontent2"))
            .destroy();
        IOStreamStorage store = this._createIOStreamStorage(storeStream);
        
        // Test elements() Iterator & order / content check
        int count = 0;
        AnyIterator it = store.elements();
        while (it.hasNext()) {
            StorageElement e = this.rt().cast(StorageElement:CLASSNAME, it.next());
            if (this.isNull(e)) { return this.fail("Iterator returned null element"); }
            
            String prop = e.getCStringProperty("pool.name");
            if (count == 0) {
                if (!prop || !prop.cequals("my::TestClass1")) {
                    return this.fail("First element name does not match expected 'my::TestClass1'");
                }
            } else if (count == 1) {
                if (!prop || !prop.cequals("my::TestClass2")) {
                    return this.fail("Second element name does not match expected 'my::TestClass2'");
                }
            }
            count++;
            e.destroy();
        }
        it.destroy();
        
        if (count != 2) {
            return this.fail("Expected 2 elements");
        }
        
        store.destroy();
        
        return this.success();
    }

    // TODO: extract to factory-class
    [SeekableIOStream] _createBufferStream(int size) {
        MemoryIOStream stream = this.rt().createInstance(MemoryIOStream:CLASSNAME);
        return stream._init(size).iostream();
    }
    
    [StoreBuilder] _initStoreStream(SeekableIOStream stream, int elements, int indexV2) {
        StoreBuilder sb := this.rt().createInstance(StoreBuilder:CLASSNAME);
        return sb._init(stream, elements, indexV2);
    }
    
    [SeekableIOStream] _createContentFromCString(cstring data) {
        String s := this.rt().createInstance(String:CLASSNAME);
        SeekableIOStream content := s.assignCString(data).toIOStream();
        content.own(s);
        return content;
    }
    
    [IOStreamStorage] _createIOStreamStorage(SeekableIOStream stream) {
        IOStreamStorage store = this.rt().createInstance(IOStreamStorage:CLASSNAME);
        store._initFromStream(stream);
        store.own(stream);
        return store;
    } 

}
