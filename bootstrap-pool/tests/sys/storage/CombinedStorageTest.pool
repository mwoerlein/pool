/*[meta]
mimetype = text/x-pool
author = Marc Woerlein <marc.woerlein@gmx.de>
version = 0.1.0
*/
namespace sys::storage;

use pool::storage::StoreBuilder;

use sys::core::String;
use sys::core::anycollection::AnyIterator;
use sys::memory::MemoryIOStream;
use sys::stream::SeekableIOStream;

class CombinedStorageTest extends test::TestCase {

    [] runAll() {
        this.testCombinedStorageGetElement();
        this.testCombinedStorageElements();
    }
    
    [int] testCombinedStorageGetElement() {
        this.start("testCombinedStorageGetElement");

        SeekableIOStream s1 := this._createBufferStream(1024);
        this._initStoreStream(s1, 2, true)
            .addElement(this._createContentFromCString("/*[pool]\nname = my::Class1\n*/\ncontent1"))
            .addElement(this._createContentFromCString("/*[pool]\nname = my::Class2\n*/\ncontent2"))
            .destroy();
        IOStreamStorage store1 := this._createIOStreamStorage(s1);

        SeekableIOStream s2 := this._createBufferStream(1024);
        this._initStoreStream(s2, 2, true)
            .addElement(this._createContentFromCString("/*[pool]\nname = my::Class3\n*/\ncontent3"))
            .addElement(this._createContentFromCString("/*[pool]\nname = my::Class4\n*/\ncontent4"))
            .destroy();
        IOStreamStorage store2 := this._createIOStreamStorage(s2);
        
        CombinedStorage combined = this.rt().createInstance(CombinedStorage:CLASSNAME);
        combined.addStorage(store1.storage());
        combined.addStorage(store2.storage());
        
        String name2 = this.rt().createInstance(String:CLASSNAME);
        name2.assignCString("my::Class2");
        
        String name3 = this.rt().createInstance(String:CLASSNAME);
        name3.assignCString("my::Class3");
        
        String nameNon = this.rt().createInstance(String:CLASSNAME);
        nameNon.assignCString("my::NonExistent");
        
        // Test getElement from first store
        StorageElement e1 = combined.getElement(name2, Mimetype:POOL_SRC);
        if (this.isNull(e1)) {
            return this.fail("Failed to find my::Class2 in combined storage");
        }
        String prop1 = e1.getCStringProperty("pool.name");
        if (!prop1 || !prop1.cequals("my::Class2")) {
            return this.fail("Incorrect element found for my::Class2");
        }
        e1.destroy();
        
        // Test getElement from second store
        StorageElement e2 = combined.getElement(name3, Mimetype:POOL_SRC);
        if (this.isNull(e2)) {
            return this.fail("Failed to find my::Class3 in combined storage");
        }
        String prop2 = e2.getCStringProperty("pool.name");
        if (!prop2 || !prop2.cequals("my::Class3")) {
            return this.fail("Incorrect element found for my::Class3");
        }
        e2.destroy();
        
        // Test non-existent element
        StorageElement e3 = combined.getElement(nameNon, Mimetype:POOL_SRC);
        if (!this.isNull(e3)) {
            return this.fail("Found non-existent element in combined storage");
        }
        
        nameNon.destroy();
        name3.destroy();
        name2.destroy();
        combined.destroy();
        
        return this.success();
    }

    [int] testCombinedStorageElements() {
        this.start("testCombinedStorageElements");

        SeekableIOStream s1 := this._createBufferStream(1024);
        this._initStoreStream(s1, 1, true)
            .addElement(this._createContentFromCString("/*[pool]\nname = my::Class1\n*/\ncontent1"))
            .destroy();
        IOStreamStorage store1 := this._createIOStreamStorage(s1);

        SeekableIOStream s2 := this._createBufferStream(1024);
        this._initStoreStream(s2, 4, true)
            .addElement(this._createContentFromCString("/*[pool]\nname = my::Class2\n*/\ncontent2"))
            .addElement(this._createContentFromCString("/*[pool]\nname = my::Class3\n*/\ncontent3"))
            .addElement(this._createContentFromCString("/*[pool]\nname = my::Class4\n*/\ncontent4"))
            .addElement(this._createContentFromCString("/*[pool]\nname = my::Class5\n*/\ncontent5"))
            .destroy();
        IOStreamStorage store2 := this._createIOStreamStorage(s2);
        
        CombinedStorage combined = this.rt().createInstance(CombinedStorage:CLASSNAME);
        combined.addStorage(store1.storage());
        combined.addStorage(store2.storage());
        
        int count = 0;
        AnyIterator it = combined.elements();
        while (it.hasNext()) {
            StorageElement e = this.rt().cast(StorageElement:CLASSNAME, it.next());
            if (this.isNull(e)) { return this.fail("Combined iterator returned null element"); }
            count++;
            e.destroy();
        }
        it.destroy();
        
        if (count != 5) {
            return this.fail("Expected 5 elements from combined storage");
        }
        
        combined.destroy();
        
        return this.success();
    }

    // TODO: extract to factory-class
    [SeekableIOStream] _createBufferStream(int size) {
        MemoryIOStream stream = this.rt().createInstance(MemoryIOStream:CLASSNAME);
        return stream._init(size).iostream();
    }
    
    [StoreBuilder] _initStoreStream(SeekableIOStream stream, int elements, int indexV2) {
        StoreBuilder sb := this.rt().createInstance(StoreBuilder:CLASSNAME);
        return sb._init(stream, elements, indexV2);
    }
    
    [SeekableIOStream] _createContentFromCString(cstring data) {
        String s := this.rt().createInstance(String:CLASSNAME);
        SeekableIOStream content := s.assignCString(data).toIOStream();
        content.own(s);
        return content;
    }
    
    [IOStreamStorage] _createIOStreamStorage(SeekableIOStream stream) {
        IOStreamStorage store = this.rt().createInstance(IOStreamStorage:CLASSNAME);
        store._initFromStream(stream);
        store.own(stream);
        return store;
    } 

}
