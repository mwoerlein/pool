/*[meta]
mimetype = text/x-pool
author = Marc Woerlein <marc.woerlein@gmx.de>
version = 0.1.0
*/
namespace sys::storage;

use sys::core::String;
use sys::core::anycollection::AnyIterator;
use sys::stream::SeekableIOStream;

class CombinedStorageTest extends sys::test::StorageTestCase {

    [] runAll() {
        this.testCombinedStorageGetElement();
        this.testCombinedStorageElements();
        this.testCombinedStorageEmpty();
    }
    
    [int] testCombinedStorageGetElement() {
        this.startCases("testCombinedStorageGetElement");

        SeekableIOStream s1 := this._createBufferStream(1024);
        this._initStoreStream(s1, 2, true)
            .addElement(this._createContentFromCString(Mimetype:TYPE_POOL_SRC, "my::Class1", "content1"))
            .addElement(this._createContentFromCString(Mimetype:TYPE_POOL_SRC, "my::Class2", "content2"))
            .destroy();
        IOStreamStorage store1 := this._createIOStreamStorage(s1);

        SeekableIOStream s2 := this._createBufferStream(1024);
        this._initStoreStream(s2, 2, true)
            .addElement(this._createContentFromCString(Mimetype:TYPE_POOL_SRC, "my::Class3", "content3"))
            .addElement(this._createContentFromCString(Mimetype:TYPE_POOL_SRC, "my::Class4", "content4"))
            .destroy();
        IOStreamStorage store2 := this._createIOStreamStorage(s2);
        
        CombinedStorage combined := this._createCombinedStorage()
            .addStorage(store1.storage())
            .addStorage(store2.storage());
        
        String name = this.rt().createInstance(String:CLASSNAME);
        
        // Search with correct mimetype and name
        name.assignCString("my::Class2");
        this.caseMatchElement(combined.getElement(name, Mimetype:POOL_SRC), Mimetype:TYPE_POOL_SRC, "my::Class2");
        name.assignCString("my::Class3");
        this.caseMatchElement(combined.getElement(name, Mimetype:POOL_SRC), Mimetype:TYPE_POOL_SRC, "my::Class3");
        
        // Search with incorrect mimetype
        this.caseNoElement(combined.getElement(name, Mimetype:POOL_ASM), "Found element with wrong mimetype");

        // Search with incorrect name
        name.assignCString("my::NonExistent");
        this.caseNoElement(combined.getElement(name, Mimetype:POOL_SRC), "Found non-existent element");

        name.destroy();
        combined.destroy();
        
        return this.successCases();
    }

    [int] testCombinedStorageElements() {
        this.startCases("testCombinedStorageElements");

        SeekableIOStream s1 := this._createBufferStream(1024);
        this._initStoreStream(s1, 1, true)
            .addElement(this._createContentFromCString(Mimetype:TYPE_POOL_SRC, "my::Class1", "content1"))
            .destroy();
        IOStreamStorage store1 := this._createIOStreamStorage(s1);

        SeekableIOStream s2 := this._createBufferStream(1024);
        this._initStoreStream(s2, 4, true)
            .addElement(this._createContentFromCString(Mimetype:TYPE_POOL_SRC, "my::Class2", "content2"))
            .addElement(this._createContentFromCString(Mimetype:TYPE_POOL_SRC, "my::Class3", "content3"))
            .addElement(this._createContentFromCString(Mimetype:TYPE_POOL_SRC, "my::Class4", "content4"))
            .addElement(this._createContentFromCString(Mimetype:TYPE_POOL_SRC, "my::Class5", "content5"))
            .destroy();
        IOStreamStorage store2 := this._createIOStreamStorage(s2);
        
        CombinedStorage combined := this._createCombinedStorage()
            .addStorage(store1.storage())
            .addStorage(store2.storage());
        
        // Test elements() Iterator & order / content check
        AnyIterator it = combined.elements();
        this.caseMatchElement(it.next(), Mimetype:TYPE_POOL_SRC, "my::Class1");
        this.caseMatchElement(it.next(), Mimetype:TYPE_POOL_SRC, "my::Class2");
        this.caseMatchElement(it.next(), Mimetype:TYPE_POOL_SRC, "my::Class3");
        this.caseMatchElement(it.next(), Mimetype:TYPE_POOL_SRC, "my::Class4");
        this.caseMatchElement(it.next(), Mimetype:TYPE_POOL_SRC, "my::Class5");
        this.caseNoElement(it.next(), "Expected 5 elements");
        it.destroy();
        
        combined.destroy();
        
        return this.successCases();
    }

    [int] testCombinedStorageEmpty() {
        this.startCases("testCombinedStorageEmpty");
        
        CombinedStorage combined := this._createCombinedStorage();
        
        String name = this.rt().createInstance(String:CLASSNAME);
        name.assignCString("my::Anything");
        
        this.caseNoElement(combined.getElement(name, Mimetype:POOL_SRC), "Combined storage without storage should return null on getElement");
        {
            AnyIterator it = combined.elements();
            this.caseNoElement(it.next(), "Combined storage without storage iterator should not have elements");
            it.destroy();
        }

        SeekableIOStream storeStream := this._createBufferStream(512);
        this._initStoreStream(storeStream, 0, true).destroy();
        IOStreamStorage store = this._createIOStreamStorage(storeStream);
        combined.addStorage(store.storage());

        this.caseNoElement(combined.getElement(name, Mimetype:POOL_SRC), "Combined storage with empty storage should return null on getElement");
        {
            AnyIterator it = combined.elements();
            this.caseNoElement(it.next(), "Combined storage with empty storage iterator should not have elements");
            it.destroy();
        }
        
        name.destroy();
        combined.destroy();
        
        return this.successCases();
    }

}
